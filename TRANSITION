// Sourced directly from the workbook's own "HCL Presence?" Yes/No column (App Data sheet),
// which is the authoritative flag — more reliable than re-deriving it from the free-text
// HCL Presence category, and it's what the workbook's own Summary tab totals (438) are built on.
function isHclPresent(a) {
  return a.hcl_present === true;
}

function matches(a) {
  if (state.domain && a.domain !== state.domain) return false;
  if (state.trench && a.trench !== state.trench) return false;
  if (state.techArea && a.tech_area !== state.techArea) return false;
  if (state.complexity && a.complexity !== state.complexity) return false;
  if (state.hcl && a.hcl !== state.hcl) return false;
  if (state.shutdownPhase && a.shutdown_phase !== state.shutdownPhase) return false;
  if (state.hclPresentOnly && !isHclPresent(a)) return false;
  if (state.overrunOnly && !(a.overrun > 0)) return false;
  if (state.rebadgeOnly && !a.rebadge_flag) return false;
  if (state.search) {
    const q = state.search.toLowerCase();
    if (!a.name.toLowerCase().includes(q) && !(a.apm || "").toLowerCase().includes(q)) return false;
  }
  return true;
}

function isFilterActive() {
  return !!(state.domain || state.trench || state.techArea || state.complexity || state.hcl || state.shutdownPhase || state.hclPresentOnly || state.overrunOnly || state.rebadgeOnly || state.search);
}

// ---------- populate filter dropdowns ----------
function fillSelect(sel, values) {
  for (const v of values) {
    const opt = document.createElement("option");
    opt.value = v; opt.textContent = v;
