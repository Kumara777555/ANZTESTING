  }

  document.getElementById('smeAhMonths').style.gridTemplateColumns = 'repeat(' + weekStarts.length + ', 1fr)';
  document.getElementById('smeAhMonths').innerHTML = monthGroups.map(function(g){
    return '<div class="sme-ah-month" style="grid-column:span '+g.span+'">'+smeEsc(g.label)+'</div>';
