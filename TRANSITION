<script>
(function(){
  "use strict";

  var MONTHS = [
    {k:"Sep",y:"'26"}, {k:"Oct",y:"'26"}, {k:"Nov",y:"'26"}, {k:"Dec",y:"'26"}, {k:"Jan",y:"'27"},
    {k:"Feb",y:"'27"}, {k:"Mar",y:"'27"}, {k:"Apr",y:"'27"}, {k:"May",y:"'27"}, {k:"Jun",y:"'27"}
  ];
  var MIDX = {}; MONTHS.forEach(function(m,i){ MIDX[m.k]=i; });

  var PHASES = [
    {key:"pre", label:"Pre-Transition", varc:"--tpop-phase-1", vari:"--tpop-phase-1-ink"},
    {key:"abs", label:"Absorption",     varc:"--tpop-phase-2", vari:"--tpop-phase-2-ink"},
    {key:"rep", label:"Replication",    varc:"--tpop-phase-3", vari:"--tpop-phase-3-ink"},
    {key:"obs", label:"Observation",    varc:"--tpop-phase-4", vari:"--tpop-phase-4-ink"}
  ];

  var TRANCHES = [
    { id:1, label:"Tranche 1", mobilize:"Sep", mobilizeLabel:"Prep & Mobilize", cutover:"Apr", span:"Sep '26 → Apr '27" },
    { id:2, label:"Tranche 2", mobilize:"Nov", mobilizeLabel:"Mobilize",        cutover:"May", span:"Nov '26 → May '27" },
    { id:3, label:"Tranche 3", mobilize:"Dec", mobilizeLabel:"Mobilize",        cutover:"Jun", span:"Dec '26 → Jun '27" }
  ];

  var WORKSTREAMS = [
    { t:1, name:"NZ",                       vol:"L",  cx:"H", apps:169, phases:{pre:"Oct",abs:"Nov",rep:"Dec",obs:"Feb"} },
    { t:1, name:"Arch & Eng",                vol:"S",  cx:"M", apps:25,  phases:{pre:"Oct",abs:"Nov",rep:"Dec",obs:"Feb"} },
    { t:1, name:"AR&C — Tranche 1",          vol:"XL", cx:"H", apps:74,  phases:{pre:"Oct",abs:"Nov",rep:"Dec",obs:"Feb"} },
    { t:1, name:"Group Services — Tranche 1",vol:"XL", cx:"M", apps:92,  phases:{pre:"Oct",abs:"Nov",rep:"Dec",obs:"Feb"} },
    { t:1, name:"Insto — Tranche 1",         vol:"M",  cx:"M", apps:19,  phases:{pre:"Oct",abs:"Nov",rep:"Dec",obs:"Feb"} },
    { t:2, name:"AR&C — Tranche 2",          vol:"XL", cx:"H", apps:129, phases:{pre:"Dec",abs:"Feb",rep:"Mar",obs:"Apr"} },
    { t:2, name:"Group Services — Tranche 2",vol:"XL", cx:"M", apps:183, phases:{pre:"Dec",abs:"Feb",rep:"Mar",obs:"Apr"} },
    { t:2, name:"Insto — Tranche 2",         vol:"M",  cx:"M", apps:60,  phases:{pre:"Dec",abs:"Feb",rep:"Mar",obs:"Apr"} },
    { t:3, name:"AR&C — Tranche 3",          vol:"XL", cx:"H", apps:155, phases:{pre:"Feb",abs:"Mar",rep:"Apr",obs:"May"} },
    { t:3, name:"Group Services — Tranche 3",vol:"XL", cx:"M", apps:37,  phases:{pre:"Feb",abs:"Mar",rep:"Apr",obs:"May"} },
    { t:3, name:"Payments",                  vol:"M",  cx:"L", apps:120, phases:{pre:"Feb",abs:"Mar",rep:"Apr",obs:"May"} },
    { t:3, name:"Security",                  vol:"S",  cx:"H", apps:56,  phases:{pre:"Feb",abs:"Mar",rep:"Apr",obs:"May"} },
    { t:3, name:"ICS",                       vol:"S",  cx:"M", apps:19,  phases:{pre:"Feb",abs:"Mar",rep:"Apr",obs:"May"} },
    { t:3, name:"Insto — Tranche 3",         vol:"M",  cx:"M", apps:16,  phases:{pre:"Feb",abs:"Mar",rep:"Apr",obs:"May"} }
  ];

  var VOL_ORDER = {S:1, M:2, L:3, XL:4};
  var CX_CLASS  = {H:"tpop-cx-h", M:"tpop-cx-m", L:"tpop-cx-l"};

  var trancheApps = {1:0,2:0,3:0};
  WORKSTREAMS.forEach(function(w){ trancheApps[w.t]+=w.apps; });
  TRANCHES.forEach(function(t){ t.totalApps = trancheApps[t.id]; });

  var appsIcon = '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/></svg>';

  function volBars(vol){
    var n = VOL_ORDER[vol];
    var out = "";
    for (var i=1;i<=4;i++){ out += '<i class="'+(i<=n?"tpop-on":"")+'"></i>'; }
    return out;
  }

  function el(tag, cls, html){
    var d = document.createElement(tag);
    if (cls) d.className = cls;
    if (html !== undefined) d.innerHTML = html;
    return d;
  }

  // ---- build header row ----
  var board = document.getElementById("tpop-board");

  var headRow = el("div","tpop-grid-row tpop-col-head");
  headRow.appendChild(el("div","tpop-meta-cell","Workstream"));
  MONTHS.forEach(function(m){
    var c = el("div","tpop-month-cell");
    c.appendChild(el("div","tpop-month-name",m.k));
    c.appendChild(el("div","tpop-month-year",m.y));
    headRow.appendChild(c);
  });
  board.appendChild(headRow);

  // ---- tranche + workstream rows ----
  var wsByTranche = {1:[],2:[],3:[]};
  WORKSTREAMS.forEach(function(w){ wsByTranche[w.t].push(w); });

  TRANCHES.forEach(function(t){
    var trow = el("div","tpop-grid-row tpop-tranche-row");
    trow.dataset.tranche = t.id;
    var meta = el("div","tpop-meta-cell");
    var nameLine = el("div","tpop-t-name-line");
    nameLine.style.color = "var(--tpop-tranche-"+t.id+")";
    var swatch = el("span","tpop-t-swatch",""); swatch.style.background = "var(--tpop-tranche-"+t.id+")";
    nameLine.appendChild(swatch);
    nameLine.appendChild(el("span","", t.label));
    meta.appendChild(nameLine);
    var sub = el("span","tpop-t-meta-sub", t.span + " · " + t.totalApps.toLocaleString() + " apps");
    meta.appendChild(sub);
    trow.appendChild(meta);

    var track = el("div","tpop-timeline-track");
    track.style.gridColumn = "2 / span 10";
    var chip = el("div","tpop-mobilize-chip", t.mobilizeLabel);
    var mi = MIDX[t.mobilize];
    var mobilizeSpan = t.id === 1 ? 2 : 1; // Tranche 1's Prep & Mobilize runs Sep-Oct on the source plan
    chip.style.left = "calc("+mi+" * (100% / 10) + 4px)";
    chip.style.width = "calc("+mobilizeSpan+" * (100% / 10) - 8px)";
    chip.style.background = "var(--tpop-tranche-"+t.id+"-tint)";
    chip.style.color = "var(--tpop-tranche-"+t.id+")";
    chip.style.border = "1px solid var(--tpop-tranche-"+t.id+")";
    track.appendChild(chip);
    trow.appendChild(track);
    trow.style.cursor = "pointer";
    trow.title = "Click to collapse/expand this tranche";
    trow.addEventListener("click", function(){
      var id = trow.dataset.tranche;
      collapsedTranches[id] = !collapsedTranches[id];
      trow.classList.toggle("tpop-collapsed", collapsedTranches[id]);
      applyFilters();
    });
    board.appendChild(trow);

    wsByTranche[t.id].forEach(function(w){
      var row = el("div","tpop-grid-row tpop-ws-row");
      row.dataset.tranche = t.id;

      var m = el("div","tpop-meta-cell");
      var nameLine = el("div","tpop-ws-name-line");
      var tdot = el("span","tpop-ws-tdot",""); tdot.style.background = "var(--tpop-tranche-"+t.id+")";
      nameLine.appendChild(tdot);
      nameLine.appendChild(el("span","tpop-ws-name", w.name));
      m.appendChild(nameLine);

      var sub = el("div","tpop-ws-sub");
      var vol = el("span","tpop-vol");
      vol.innerHTML = '<span class="tpop-vol-bars">'+volBars(w.vol)+'</span><span class="tpop-vol-label">'+w.vol+'</span>';
      sub.appendChild(vol);
      var cx = el("span","tpop-cx "+CX_CLASS[w.cx]);
      cx.innerHTML = '<i></i>'+w.cx;
      sub.appendChild(cx);
      var apps = el("span","tpop-apps-pill");
      apps.innerHTML = appsIcon + w.apps;
      sub.appendChild(apps);
      m.appendChild(sub);
      row.appendChild(m);

      var ttrack = el("div","tpop-timeline-track");
      ttrack.style.gridColumn = "2 / span 10";
      PHASES.forEach(function(p){
        var monthKey = w.phases[p.key];
        if (!monthKey) return;
        var idx = MIDX[monthKey];
        var block = el("div","tpop-phase-block", p.label.split("-")[0].slice(0,3) === "Pre" ? "Pre" : p.label.slice(0,3));
        block.dataset.phase = p.key;
        block.style.left = "calc("+idx+" * (100% / 10) + 4px)";
        block.style.width = "calc(100% / 10 - 8px)";
        block.style.background = "var("+p.varc+")";
        block.style.color = "var("+p.vari+")";
        block.addEventListener("mouseenter", function(e){ showTip(e, w, p, monthKey, t); });
        block.addEventListener("mousemove", moveTip);
        block.addEventListener("mouseleave", hideTip);
        ttrack.appendChild(block);
      });
      row.appendChild(ttrack);
      board.appendChild(row);
    });
  });

  // ---- cutover row ----
  var curow = el("div","tpop-grid-row tpop-cutover-row");
  curow.appendChild(el("div","tpop-meta-cell","Cutover milestones"));
  var ctrack = el("div","tpop-timeline-track");
  ctrack.style.gridColumn = "2 / span 10";
  TRANCHES.forEach(function(t){
    var idx = MIDX[t.cutover];
    var flag = el("div","tpop-cutover-flag");
    flag.style.left = "calc("+idx+" * (100% / 10))";
    flag.style.color = "var(--tpop-tranche-"+t.id+")";
    flag.innerHTML = '<span class="tpop-tri"></span><span class="tpop-flag-label">T'+t.id+' cutover</span>';
    ctrack.appendChild(flag);
  });
  curow.appendChild(ctrack);
  board.appendChild(curow);

  // ---- overlay: holiday band + cutover guide lines, measured from real column geometry ----
  var overlay = el("div","tpop-overlay");
  board.appendChild(overlay);

  function layoutOverlay(){
    overlay.innerHTML = "";
    var boardRect = board.getBoundingClientRect();
    var cells = headRow.querySelectorAll(".tpop-month-cell");
    if (!cells.length) return;
    var lefts = [];
    cells.forEach(function(c){ var r = c.getBoundingClientRect(); lefts.push(r.left - boardRect.left); });
    var lastCell = cells[cells.length-1].getBoundingClientRect();
    var rightEdge = lastCell.right - boardRect.left;
    var colWidth = lefts.length>1 ? (lefts[1]-lefts[0]) : (rightEdge-lefts[0]);

    // Holiday: 25 Dec -> 25 Jan. Dec is idx3, Jan is idx4. ~80% into Dec through ~80% into Jan.
    var decLeft = lefts[3], janLeft = lefts[4];
    var hStart = decLeft + colWidth*0.78;
    var hEnd = janLeft + colWidth*0.82;
    var band = el("div","tpop-holiday-band");
    band.style.left = hStart+"px";
    band.style.width = (hEnd-hStart)+"px";
    var label = el("div","tpop-holiday-label","Holiday · 25 Dec–25 Jan");
    label.style.left = ((hStart+hEnd)/2)+"px";
    band.appendChild(label);
    overlay.appendChild(band);

    // Cutover guide lines at the start of each cutover month
    TRANCHES.forEach(function(t){
      var idx = MIDX[t.cutover];
      var x = lefts[idx];
      var line = el("div","tpop-cutover-line");
      line.style.left = x+"px";
      line.style.borderLeftColor = "var(--tpop-tranche-"+t.id+")";
      overlay.appendChild(line);
    });
  }

  window.tpopLayoutOverlay = layoutOverlay;
  window.addEventListener("resize", layoutOverlay);
  setTimeout(layoutOverlay, 30);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(layoutOverlay);

  // ---- tooltip ----
  var tip = document.getElementById("tpop-tooltip");
  function showTip(e, w, p, monthKey, t){
    var my = MONTHS[MIDX[monthKey]];
    tip.innerHTML =
      '<div class="tpop-tt-title">'+w.name+'</div>'+
      '<div class="tpop-tt-row">'+p.label+' · '+my.k+' '+my.y+'</div>'+
      '<div class="tpop-tt-row">Tranche '+t.id+' · '+w.apps+' apps · Vol '+w.vol+' · Complexity '+w.cx+'</div>';
    tip.classList.add("tpop-show");
    moveTip(e);
  }
  function moveTip(e){
    var x = e.clientX, y = e.clientY;
    var vw = window.innerWidth, vh = window.innerHeight;
    var tw = tip.offsetWidth || 220, th = tip.offsetHeight || 60;
    var left = Math.min(x+14, vw-tw-10);
    var top = Math.min(y+16, vh-th-10);
    tip.style.left = left+"px";
    tip.style.top = top+"px";
  }
  function hideTip(){ tip.classList.remove("tpop-show"); }

  // ---- table view ----
  var tbody = document.getElementById("tpop-table-body");
  WORKSTREAMS.forEach(function(w){
    var tr = el("tr");
    tr.dataset.tranche = w.t;
    tr.innerHTML =
      '<td>'+w.name+'</td>'+
      '<td>T'+w.t+'</td>'+
      '<td class="tpop-mono">'+w.vol+'</td>'+
      '<td class="tpop-mono">'+w.cx+'</td>'+
      '<td class="tpop-mono tpop-num">'+w.apps+'</td>'+
      '<td class="tpop-mono">'+w.phases.pre+'</td>'+
      '<td class="tpop-mono">'+w.phases.abs+'</td>'+
      '<td class="tpop-mono">'+w.phases.rep+'</td>'+
      '<td class="tpop-mono">'+w.phases.obs+'</td>'+
      '<td class="tpop-mono">T'+w.t+' · '+TRANCHES[w.t-1].cutover+'</td>';
    tbody.appendChild(tr);
  });

  // ---- interactions: tranche filter ----
  var activeTranche = "all";
  var collapsedTranches = {};
  var searchQuery = "";
  var chips = document.querySelectorAll(".tpop-chip");
  chips.forEach(function(chip){
    chip.addEventListener("click", function(){
      activeTranche = chip.dataset.t;
      chips.forEach(function(c){ c.setAttribute("aria-pressed", c===chip ? "true":"false"); });
      applyFilters();
    });
  });

  var activePhases = {pre:true, abs:true, rep:true, obs:true};
  document.querySelectorAll(".tpop-legend-item").forEach(function(li){
    li.addEventListener("click", function(){
      var p = li.dataset.phase;
      activePhases[p] = !activePhases[p];
      li.setAttribute("aria-pressed", activePhases[p] ? "true":"false");
      applyFilters();
    });
  });

  var wsByName = {};
  WORKSTREAMS.forEach(function(w){ wsByName[w.name] = w; });

  var searchInput = document.getElementById("tpop-search");
  searchInput.addEventListener("input", function(){
    searchQuery = searchInput.value.trim().toLowerCase();
    applyFilters();
  });

  document.getElementById("tpop-expand-all").addEventListener("click", function(){
    collapsedTranches = {};
    document.querySelectorAll(".tpop-tranche-row").forEach(function(r){ r.classList.remove("tpop-collapsed"); });
    applyFilters();
  });
  document.getElementById("tpop-collapse-all").addEventListener("click", function(){
    TRANCHES.forEach(function(t){ collapsedTranches[t.id] = true; });
    document.querySelectorAll(".tpop-tranche-row").forEach(function(r){ r.classList.add("tpop-collapsed"); });
    applyFilters();
  });

  function applyFilters(){
    document.querySelectorAll(".tpop-ws-row").forEach(function(row){
      var w = wsByName[row.querySelector(".tpop-ws-name").textContent];
      var trancheMatch = (activeTranche === "all" || row.dataset.tranche === activeTranche);
      var searchMatch = !searchQuery || (w && w.name.toLowerCase().indexOf(searchQuery) !== -1);
      var collapsed = !!collapsedTranches[row.dataset.tranche];
      row.classList.toggle("tpop-row-hide", !trancheMatch || !searchMatch || collapsed);
    });
    document.querySelectorAll(".tpop-tranche-row").forEach(function(row){
      var match = (activeTranche === "all" || row.dataset.tranche === activeTranche);
      row.classList.toggle("tpop-row-hide", !match);
    });
    document.querySelectorAll("#tpop-table-body tr").forEach(function(row){
      var name = row.children[0].textContent;
      var trancheMatch = (activeTranche === "all" || row.dataset.tranche === activeTranche);
      var searchMatch = !searchQuery || name.toLowerCase().indexOf(searchQuery) !== -1;
      row.classList.toggle("tpop-row-hide", !trancheMatch || !searchMatch);
    });
    document.querySelectorAll(".tpop-phase-block").forEach(function(b){
      b.classList.toggle("tpop-phase-dim", !activePhases[b.dataset.phase]);
    });
    updateStats();
    setTimeout(layoutOverlay, 10);
  }

  function updateStats(){
    var apps = 0, tranches = 0, wsCount = 0;
    var seenT = {};
    WORKSTREAMS.forEach(function(w){
      if (activeTranche === "all" || String(w.t) === activeTranche){
        apps += w.apps; wsCount++; seenT[w.t]=1;
      }
    });
    tranches = Object.keys(seenT).length;
    document.getElementById("tpop-stat-apps").textContent = apps.toLocaleString();
    document.getElementById("tpop-stat-tranches").textContent = tranches;
    document.getElementById("tpop-stat-workstreams").textContent = wsCount;
  }

  // ---- view toggle ----
  var boardWrap = document.getElementById("tpop-board-wrap");
  var tableWrap = document.getElementById("tpop-table-wrap");
  var legend = document.getElementById("tpop-legend");
  document.querySelectorAll(".tpop-view-toggle button").forEach(function(btn){
    btn.addEventListener("click", function(){
      document.querySelectorAll(".tpop-view-toggle button").forEach(function(b){ b.setAttribute("aria-pressed", b===btn?"true":"false"); });
      var isTable = btn.dataset.view === "table";
      boardWrap.style.display = isTable ? "none":"block";
      legend.style.display = isTable ? "none":"flex";
      tableWrap.style.display = isTable ? "block":"none";
    });
  });

  // ---- footer summary ----
  document.getElementById("tpop-footer-tranche-summary").textContent =
    TRANCHES.map(function(t){ return "T"+t.id+" "+t.span; }).join("   ·   ");

})();
</script>

