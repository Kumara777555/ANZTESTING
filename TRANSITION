const REB_OUTCOMES = ["Rebadge","Redeploy","Exit"];
const REB_OCOLOR = { Rebadge:"var(--reb-rebadge)", Redeploy:"var(--reb-redeploy)", Exit:"var(--reb-exit)" };
const REB_OWASH  = { Rebadge:"var(--reb-rebadge-tint)", Redeploy:"var(--reb-redeploy-tint)", Exit:"var(--reb-exit-tint)" };

// Sourced from Rebadging Data.xlsx ("Vendor 0901" sheet), column F ("Associated Apps"):
// the role IDs for which column F is NOT blank, i.e. an application was actually mapped
// to that role. Every other id in REB_DATA has a blank column F for that role.
const REB_HAS_APP_ID = new Set([73, 112, 154, 111, 146, 245, 80, 326, 92, 14, 104, 328, 151, 148, 18, 141, 21, 25, 93, 250, 247, 159, 32, 155, 185, 248, 243, 98, 100, 101, 102, 168, 8, 44, 94, 244, 153, 184, 331, 144, 145, 114, 152, 156, 95, 157, 158, 103, 108, 110, 332, 163, 150, 3, 12]);
REB_DATA.forEach(d => { d.hasAppId = REB_HAS_APP_ID.has(d.id); });

const rebState = {
  q:"", loc:"", tier:"", group:"", grade:"",
  outcomes: new Set(REB_OUTCOMES),
  sortKey:"id", sortDir:1
};

function rebUniq(key, sortFn){
  const s = new Set(REB_DATA.map(d=>d[key]));
  return [...s].sort(sortFn);
}
const REB_LOCS = rebUniq("loc");
const REB_TIERS = rebUniq("tier2");
const REB_GROUPS = rebUniq("group");
const REB_GRADES = rebUniq("grade", (a,b)=> a.localeCompare(b, undefined, {numeric:true}));

function rebFillSelect(id, values, labelFn){
  const el = document.getElementById(id);
  values.forEach(v=>{
    const o = document.createElement("option");
    o.value = v; o.textContent = labelFn ? labelFn(v) : v;
    el.appendChild(o);
  });
}
rebFillSelect("reb-f-loc", REB_LOCS);
rebFillSelect("reb-f-tier", REB_TIERS, v => v.includes("-") ? v.split("-").slice(1).join("-") : v);
rebFillSelect("reb-f-group", REB_GROUPS);
rebFillSelect("reb-f-grade", REB_GRADES);

// outcome chips
const rebChipWrap = document.getElementById("reb-outcome-chips");
REB_OUTCOMES.forEach(o=>{
  const c = document.createElement("button");
  c.type="button"; c.className="reb-chip"; c.setAttribute("aria-pressed","true");
  c.style.setProperty("--reb-chip-c", REB_OCOLOR[o]);
  c.innerHTML = `<span class="reb-dot"></span>${o}`;
  c.addEventListener("click", ()=>{
    if(rebState.outcomes.has(o)){
      if(rebState.outcomes.size>1) rebState.outcomes.delete(o);
    } else rebState.outcomes.add(o);
    c.setAttribute("aria-pressed", rebState.outcomes.has(o));
    rebRender();
  });
  rebChipWrap.appendChild(c);
});

// legend (shared, static)
const rebLegendEl = document.getElementById("reb-legend");
rebLegendEl.innerHTML = REB_OUTCOMES.map(o=>{
  const total = REB_DATA.filter(d=>d.outcome===o).length;
  return `<span class="reb-item"><span class="reb-sw" style="background:${REB_OCOLOR[o]}"></span>${o} <span class="reb-mono" style="color:var(--reb-muted)">&middot; ${total}</span></span>`;
}).join("");

document.getElementById("reb-q").addEventListener("input", e=>{ rebState.q = e.target.value.trim().toLowerCase(); rebRender(); });
document.getElementById("reb-f-loc").addEventListener("change", e=>{ rebState.loc = e.target.value; rebRender(); });
document.getElementById("reb-f-tier").addEventListener("change", e=>{ rebState.tier = e.target.value; rebRender(); });
document.getElementById("reb-f-group").addEventListener("change", e=>{ rebState.group = e.target.value; rebRender(); });
document.getElementById("reb-f-grade").addEventListener("change", e=>{ rebState.grade = e.target.value; rebRender(); });
document.getElementById("reb-reset").addEventListener("click", ()=>{
  rebState.q=""; rebState.loc=""; rebState.tier=""; rebState.group=""; rebState.grade="";
  rebState.outcomes = new Set(REB_OUTCOMES);
  document.getElementById("reb-q").value="";
  ["reb-f-loc","reb-f-tier","reb-f-group","reb-f-grade"].forEach(id=>document.getElementById(id).value="");
  rebChipWrap.querySelectorAll(".reb-chip").forEach(c=>c.setAttribute("aria-pressed","true"));
  rebRender();
});

function rebFiltered(){
  return REB_DATA.filter(d=>{
    if(!rebState.outcomes.has(d.outcome)) return false;
    if(rebState.loc && d.loc!==rebState.loc) return false;
    if(rebState.tier && d.tier2!==rebState.tier) return false;
    if(rebState.group && d.group!==rebState.group) return false;
    if(rebState.grade && d.grade!==rebState.grade) return false;
    if(rebState.q){
      const hay = (d.id+" "+d.title+" "+d.tier2+" "+d.group+" "+d.apps+" "+d.grade).toLowerCase();
      if(!hay.includes(rebState.q)) return false;
    }
    return true;
  });
}

function rebIsDefaultFilters(){
  return !rebState.q && !rebState.loc && !rebState.tier && !rebState.group && !rebState.grade && rebState.outcomes.size===3;
}

// ---------- Stat tiles ----------
const rebTilesEl = document.getElementById("reb-tiles");
function rebRenderTiles(rows){
  const total = rows.length;
  const cells = [{key:"__total", label:"Filtered roles", c:"var(--reb-ink-soft)"}]
    .concat(REB_OUTCOMES.map(o=>({key:o, label:o, c:REB_OCOLOR[o]})))
    .concat([{key:"__noapp", label:"Rebadge — no App ID", c:"var(--reb-muted)"}]);
  rebTilesEl.innerHTML = cells.map(c=>{
    let n, pctLabel;
    if (c.key==="__total") {
      n = total;
      pctLabel = "of 301 total";
    } else if (c.key==="__noapp") {
      const rebadgeRows = rows.filter(r=>r.outcome==="Rebadge");
      n = rebadgeRows.filter(r=>!r.hasAppId).length;
      pctLabel = rebadgeRows.length ? Math.round(n/rebadgeRows.length*100)+"% of Rebadge roles shown" : "—";
    } else {
      n = rows.filter(r=>r.outcome===c.key).length;
      const pct = total ? Math.round(n/total*100) : 0;
      pctLabel = pct+"% of shown";
    }
    return `<div class="reb-tile" style="--reb-tile-c:${c.c}">
      <div class="reb-lbl"><span class="reb-swatch"></span>${c.label}</div>
      <div class="reb-num">${n}</div>
      <div class="reb-pct">${pctLabel}</div>
    </div>`;
  }).join("");
}

// ---------- Tooltip ----------
const rebTip = document.getElementById("reb-tip");
function rebShowTip(e, html){
  rebTip.innerHTML = html;
  rebTip.style.left = e.clientX+"px";
  rebTip.style.top = e.clientY+"px";
  rebTip.classList.add("reb-show");
}
function rebMoveTip(e){ rebTip.style.left = e.clientX+"px"; rebTip.style.top = e.clientY+"px"; }
function rebHideTip(){ rebTip.classList.remove("reb-show"); }

// ---------- Horizontal stacked bar chart ----------
function rebBuildChart(containerId, rows, groupKey, groupLabelFn, activeVal, onClick, topN){
  const el = document.getElementById(containerId);
  const groups = {};
  rows.forEach(r=>{
    const k = r[groupKey];
    if(!groups[k]) groups[k] = {Rebadge:0,Redeploy:0,Exit:0,total:0};
    groups[k][r.outcome]++; groups[k].total++;
  });
  let keys = Object.keys(groups).sort((a,b)=>groups[b].total-groups[a].total);
  if(topN) keys = keys.slice(0, topN);
  const max = Math.max(1, ...keys.map(k=>groups[k].total));
  el.innerHTML = "";
  if(keys.length===0){
    el.innerHTML = `<div style="font-size:12.5px;color:var(--reb-muted);padding:6px 0;">No matching data</div>`;
    return;
  }
  keys.forEach(k=>{
    const g = groups[k];
    const row = document.createElement("div");
    row.className = "reb-chart-row" + (activeVal===k ? " reb-selected" : "");
    const isActive = activeVal===k;
    const isDim = activeVal && !isActive;
    const label = document.createElement("div");
    label.className = "reb-rlabel" + (isActive ? " reb-active":"");
    label.textContent = groupLabelFn ? groupLabelFn(k) : k;
    label.title = k;
    label.addEventListener("click", ()=>onClick(isActive ? "" : k));
    const track = document.createElement("div");
    track.className = "reb-track";
    const widthPct = (g.total/max*100);
    track.style.width = widthPct+"%";
    REB_OUTCOMES.forEach(o=>{
      if(!g[o]) return;
      const seg = document.createElement("div");
      seg.className = "reb-seg" + (isDim ? " reb-dim":"");
      seg.style.background = REB_OCOLOR[o];
      seg.style.width = (g[o]/g.total*100)+"%";
      seg.tabIndex = 0;
      seg.setAttribute("role","button");
      seg.setAttribute("aria-label", `${groupLabelFn?groupLabelFn(k):k}, ${o}: ${g[o]}`);
      seg.addEventListener("mouseenter", e=>rebShowTip(e, `${groupLabelFn?groupLabelFn(k):k} &middot; ${o}: <span class="reb-tval">${g[o]}</span> (${Math.round(g[o]/g.total*100)}%)`));
      seg.addEventListener("mousemove", rebMoveTip);
      seg.addEventListener("mouseleave", rebHideTip);
      seg.addEventListener("click", ()=>onClick(isActive ? "" : k));
      seg.addEventListener("keydown", e=>{ if(e.key==="Enter"||e.key===" "){ e.preventDefault(); onClick(isActive?"":k); }});
      track.appendChild(seg);
    });
    const total = document.createElement("div");
    total.className = "reb-total reb-mono";
    total.textContent = g.total;
    row.appendChild(label); row.appendChild(track); row.appendChild(total);
    el.appendChild(row);
  });
}

function rebShortTier(t){ return t.includes("-") ? t.split("-").slice(1).join("-") : t; }

// ---------- Table ----------
const REB_COLS = [
  {key:"id", label:"ID", cls:"reb-id", w:"64px"},
  {key:"title", label:"Position", cls:""},
  {key:"tier2s", label:"Domain", cls:"reb-domain"},
  {key:"grade", label:"Grade", cls:"reb-grade"},
  {key:"outcome", label:"Outcome", cls:""},
  {key:"group", label:"Tranche", cls:""},
  {key:"apps", label:"Application(s)", cls:"reb-apps"},
  {key:"loc", label:"Location", cls:""}
];
const rebTheadRow = document.getElementById("reb-thead-row");
rebTheadRow.innerHTML = REB_COLS.map(c=>`<th data-key="${c.key}"><button type="button">${c.label} <span class="reb-arrow">&#9662;</span></button></th>`).join("");
rebTheadRow.querySelectorAll("th").forEach(th=>{
  th.addEventListener("click", ()=>{
    const key = th.dataset.key;
    if(rebState.sortKey===key) rebState.sortDir *= -1;
    else { rebState.sortKey = key; rebState.sortDir = 1; }
    rebRender();
  });
});

function rebSortRows(rows){
  const {sortKey, sortDir} = rebState;
  return [...rows].sort((a,b)=>{
    let av=a[sortKey], bv=b[sortKey];
    if(sortKey==="id"){ av=+av; bv=+bv; }
    if(typeof av==="string") { av=av.toLowerCase(); bv=(bv||"").toLowerCase(); }
    if(av<bv) return -1*sortDir;
    if(av>bv) return 1*sortDir;
    return 0;
  });
}

const rebTbody = document.getElementById("reb-tbody");
function rebRenderTable(rows){
  rebTheadRow.querySelectorAll("th").forEach(th=>{
    th.classList.toggle("reb-sorted", th.dataset.key===rebState.sortKey);
    const arrow = th.querySelector(".reb-arrow");
    arrow.innerHTML = th.dataset.key===rebState.sortKey ? (rebState.sortDir===1 ? "&#9652;" : "&#9662;") : "&#9662;";
  });
  const sorted = rebSortRows(rows);
  document.getElementById("reb-empty").hidden = sorted.length>0;
  rebTbody.innerHTML = sorted.map(r=>{
    const apps = (r.apps||"").replace(/\n/g," &middot; ");
    const appsShort = apps.length>70 ? apps.slice(0,68)+"&hellip;" : (apps || "&mdash;");
    return `<tr>
      <td class="reb-id">${r.id}</td>
      <td>${rebEscapeHtml(r.title)||"&mdash;"}</td>
      <td class="reb-domain" title="${rebEscapeHtml(r.tier2)}">${rebEscapeHtml(r.tier2s)}</td>
      <td class="reb-grade">${rebEscapeHtml(r.grade)}</td>
      <td><span class="reb-pill" style="background:${REB_OWASH[r.outcome]};color:${REB_OCOLOR[r.outcome]}"><span class="reb-d" style="background:${REB_OCOLOR[r.outcome]}"></span>${r.outcome}</span></td>
      <td class="reb-tranche" title="${rebEscapeHtml(r.group)}">${rebEscapeHtml(r.group)}</td>
      <td class="reb-apps" title="${rebEscapeHtml(r.apps)}">${appsShort}</td>
      <td>${rebEscapeHtml(r.loc)}</td>
    </tr>`;
  }).join("");
  document.getElementById("reb-table-note").textContent = sorted.length + (sorted.length===1?" row":" rows");
}

function rebEscapeHtml(s){
  return (s??"").toString().replace(/[&<>"']/g, m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
}

// ---------- Header stat chips (shared #statRow) ----------
function renderRebadgeStats(){
  const total = REB_DATA.length;
  const counts = {};
  REB_OUTCOMES.forEach(o=> counts[o] = REB_DATA.filter(d=>d.outcome===o).length);
  const chips = [
    { n: total.toLocaleString(), l: "Roles in scope" },
    { n: counts.Rebadge, l: "Rebadge" },
    { n: counts.Redeploy, l: "Redeploy" },
    { n: counts.Exit, l: "Exit", cls: "critical" },
  ];
  document.getElementById("statRow").innerHTML = chips.map(c =>
    `<div class="stat-chip ${c.cls || ""}"><span class="n">${c.n}</span><span class="l">${c.l}</span></div>`
  ).join("");
}

// ---------- Master render ----------
function rebRender(){
  const rows = rebFiltered();
  document.getElementById("reb-n-shown").textContent = rows.length;
  document.getElementById("reb-filter-flag").hidden = rebIsDefaultFilters();
  rebRenderTiles(rows);
  rebBuildChart("reb-chart-tier", rows, "tier2", rebShortTier, rebState.tier, v=>{ rebState.tier=v; document.getElementById("reb-f-tier").value=v; rebRender(); });
  rebBuildChart("reb-chart-group", rows, "group", null, rebState.group, v=>{ rebState.group=v; document.getElementById("reb-f-group").value=v; rebRender(); });
  rebBuildChart("reb-chart-loc", rows, "loc", null, rebState.loc, v=>{ rebState.loc=v; document.getElementById("reb-f-loc").value=v; rebRender(); });
  rebRenderTable(rows);
}
rebRender();
window.renderRebadgeStats = renderRebadgeStats;

})();
</script>
