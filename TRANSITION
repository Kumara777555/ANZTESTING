// ---------- tooltip ----------
const tooltip = document.getElementById("tooltip");
const PHASE_INFO = {
  pre: { label: "Pre-Transition", varName: "--phase-pre", sKey: "pre_s", eKey: "pre_e", txtKey: "pre_txt" },
  ab:  { label: "Absorption",     varName: "--phase-ab",  sKey: "ab_s",  eKey: "ab_e",  txtKey: "ab_txt" },
  rep: { label: "Replication",    varName: "--phase-rep", sKey: "rep_s", eKey: "rep_e", txtKey: "rep_txt" },
  obs: { label: "Observation",    varName: "--phase-obs", sKey: "obs_s", eKey: "obs_e", txtKey: "obs_txt" },
};
function showTooltip(barEl, evt) {
  const row = barEl.closest(".row.app");
  const a = RAW[+row.dataset.idx];
  const cls = ["pre", "ab", "rep", "obs"].find(c => barEl.classList.contains(c));
  const info = PHASE_INFO[cls];
  const color = getComputedStyle(document.documentElement).getPropertyValue(info.varName).trim();
  const hclPresent = isHclPresent(a);
  let html = `<div class="tt-title">${escHtml(a.name)}</div>
    <div class="tt-row"><span class="tt-key">Domain</span><span class="tt-val">${escHtml(a.domain)}</span></div>
    <div class="tt-row"><span class="tt-key">Tranche</span><span class="tt-val">${escHtml(a.trench)}</span></div>
    <div class="tt-row"><span class="tt-key">Complexity</span><span class="tt-val">${escHtml(a.complexity)}</span></div>
    <div class="tt-row"><span class="tt-key">HCL Presence</span><span class="tt-val" style="${hclPresent ? `color:var(--status-good)` : ""}">${hclPresent ? escHtml(a.hcl) : "None recorded"}</span></div>
    <div class="tt-row"><span class="tt-key">App Transition Milestone</span><span class="tt-val">${escHtml(a.shutdown_phase)}</span></div>
    ${a.rebadge_flag ? `<div class="tt-warn" style="color:var(--focus)">🔵 Flagged for staff rebadging</div>` : ""}
    <div class="tt-phase"><span class="tt-dot" style="background:${color}"></span>${info.label} (${escHtml(a[info.txtKey] || "")})</div>
    <div class="tt-row"><span class="tt-key">Start</span><span class="tt-val">${fmtDate(a[info.sKey])}</span></div>
    <div class="tt-row"><span class="tt-key">End</span><span class="tt-val">${fmtDate(a[info.eKey])}</span></div>`;
  if (cls === "obs") {
    html += `<div class="tt-row"><span class="tt-key">Tranche window</span><span class="tt-val">${fmtShort(a.trench_start)} – ${fmtShort(a.trench_end)}</span></div>`;
    if (a.overrun > 0) html += `<div class="tt-warn">⚠ Finishes ${a.overrun} day${a.overrun === 1 ? "" : "s"} after Tranche end</div>`;
  }
  tooltip.innerHTML = html;
  positionTooltip(evt);
  tooltip.classList.add("show");
  tooltip.setAttribute("aria-hidden", "false");
}
function positionTooltip(evt) {
  const pad = 14;
  let x = evt.clientX + pad, y = evt.clientY + pad;
  const rect = tooltip.getBoundingClientRect();
  if (x + rect.width > window.innerWidth - 8) x = evt.clientX - rect.width - pad;
  if (y + rect.height > window.innerHeight - 8) y = evt.clientY - rect.height - pad;
  tooltip.style.left = x + "px";
  tooltip.style.top = y + "px";
}
function hideTooltip() {
  tooltip.classList.remove("show");
  tooltip.setAttribute("aria-hidden", "true");
}
function showNameTooltip(nameEl, evt) {
  const row = nameEl.closest(".row.app");
  const a = RAW[+row.dataset.idx];
  const hclPresent = isHclPresent(a);
  const html = `<div class="tt-title">${escHtml(a.name)}</div>
    <div class="tt-row"><span class="tt-key">APM ID</span><span class="tt-val">${escHtml(a.apm || "—")}</span></div>
    <div class="tt-row"><span class="tt-key">Domain</span><span class="tt-val">${escHtml(a.domain)}</span></div>
    <div class="tt-row"><span class="tt-key">Tech Area</span><span class="tt-val">${escHtml(a.tech_area || "—")}</span></div>
    <div class="tt-row"><span class="tt-key">HCL Presence</span><span class="tt-val" style="${hclPresent ? `color:var(--status-good)` : ""}">${hclPresent ? escHtml(a.hcl) : "None recorded"}</span></div>
    <div class="tt-row"><span class="tt-key">App Transition Milestone</span><span class="tt-val">${escHtml(a.shutdown_phase)}</span></div>
    ${hclPresent ? `<div class="tt-warn" style="color:var(--status-good)">🛡 Covered by HCLTech — lower transition risk</div>` : ""}
    ${a.rebadge_flag ? `<div class="tt-warn" style="color:var(--focus)">🔵 Flagged for staff rebadging</div>` : ""}`;
  tooltip.innerHTML = html;
  positionTooltip(evt);
  tooltip.classList.add("show");
  tooltip.setAttribute("aria-hidden", "false");
}
document.getElementById("ganttBody").addEventListener("pointerover", e => {
  const bar = e.target.closest(".bar");
  if (bar) { showTooltip(bar, e); return; }
  const nameEl = e.target.closest(".app-name");
  if (nameEl) showNameTooltip(nameEl, e);
});
document.getElementById("ganttBody").addEventListener("pointermove", e => {
  if ((e.target.closest(".bar") || e.target.closest(".app-name")) && tooltip.classList.contains("show")) positionTooltip(e);
});
document.getElementById("ganttBody").addEventListener("pointerout", e => {
  if (e.target.closest(".bar") || e.target.closest(".app-name")) hideTooltip();
});
document.getElementById("ganttBody").addEventListener("focusin", e => {
  const bar = e.target.closest(".bar");
  if (bar) {
    const r = bar.getBoundingClientRect();
    showTooltip(bar, { clientX: r.right, clientY: r.top });
    return;
  }
  const nameEl = e.target.closest(".app-name");
  if (nameEl) {
    const r = nameEl.getBoundingClientRect();
    showNameTooltip(nameEl, { clientX: r.right, clientY: r.top });
  }
});
document.getElementById("ganttBody").addEventListener("focusout", e => {
  if (e.target.closest(".bar") || e.target.closest(".app-name")) hideTooltip();
});
document.getElementById("ganttScroll").addEventListener("scroll", hideTooltip);

