const TODAY = new Date(); TODAY.setHours(0, 0, 0, 0);

const phaseOrder = [];
const phaseMap = new Map();
for (const a of ACTIONS) {
  if (!phaseMap.has(a.phase)) { phaseMap.set(a.phase, []); phaseOrder.push(a.phase); }
  phaseMap.get(a.phase).push(a);
}
const owners = [...new Set(ACTIONS.map(a => a.owner))].sort();

const actionState = {
  search: "", phase: "", owner: "", urgency: "", status: "", overdueOnly: false,
  collapsedPhases: new Set(),
};

function isOverdue(a) {
  if (a.status === "Done" || a.status === "Completed" || !a.due) return false;
  return toDate(a.due) < TODAY;
}
function actionMatches(a) {
  if (actionState.phase && a.phase !== actionState.phase) return false;
  if (actionState.owner && a.owner !== actionState.owner) return false;
  if (actionState.urgency && a.urgency !== actionState.urgency) return false;
  if (actionState.status && a.status !== actionState.status) return false;
  if (actionState.overdueOnly && !isOverdue(a)) return false;
  if (actionState.search) {
    const q = actionState.search.toLowerCase();
    const hay = (a.action + " " + a.owner + " " + (a.notes || "") + " " + a.category).toLowerCase();
    if (!hay.includes(q)) return false;
  }
  return true;
}

fillSelect(document.getElementById("phaseSelect"), phaseOrder);
fillSelect(document.getElementById("ownerSelect"), owners);
fillSelect(document.getElementById("urgencySelect"), ["High", "Medium", "Low"]);
fillSelect(document.getElementById("statusSelect"), [...new Set(ACTIONS.map(a => a.status))]);

function renderActionsStats() {
  const total = ACTIONS.length;
  const overdueCount = ACTIONS.filter(isOverdue).length;
  const notStarted = ACTIONS.filter(a => a.status === "Not Started").length;
  const highUrgentOpen = ACTIONS.filter(a => a.urgency === "High" && a.status !== "Done" && a.status !== "Completed").length;
  const completedCount = ACTIONS.filter(a => a.status === "Completed" || a.status === "Done").length;
  const chips = [
    { n: total, l: "Actions" },
    { n: notStarted, l: "Not started" },
    { n: completedCount, l: "Completed", cls: "good" },
    { n: highUrgentOpen, l: "High urgency open" },
    { n: overdueCount, l: "Overdue", cls: overdueCount ? "critical" : "" },
  ];
  document.getElementById("statRow").innerHTML = chips.map(c =>
    `<div class="stat-chip ${c.cls || ""}"><span class="n">${c.n}</span><span class="l">${c.l}</span></div>`
  ).join("");
}

function statusClass(s) { return "status-" + s.replace(/\s+/g, "-"); }

