// ---------- stats ----------
function renderGanttStats() {
  const total = RAW.length;
  const domains = domainOrder.length;
  const filterActive = isFilterActive();
  const matched = filterActive ? RAW.filter(matches) : RAW;
  const matchCount = matched.length;
  const overrunCount = matched.filter(a => a.overrun > 0).length;
  const domainsMatched = new Set(matched.map(a => a.domain)).size;
  const chips = [
    {
      n: filterActive ? `${matchCount.toLocaleString()} / ${total.toLocaleString()}` : total.toLocaleString(),
      l: filterActive ? "Applications matching filters" : "Applications",
      cls: filterActive ? "filtered" : "",
    },
    { n: filterActive ? `${domainsMatched} / ${domains}` : domains, l: "Domains" },
    { n: 3, l: "Tranches" },
    { n: overrunCount, l: "Run past Tranche end", cls: "critical" },
  ];
  document.getElementById("statRow").innerHTML = chips.map(c =>
    `<div class="stat-chip ${c.cls || ""}"><span class="n">${c.n}</span><span class="l">${c.l}</span></div>`
  ).join("");
}

// ---------- shared holiday band (rendered in both the header and every row) ----------
function holidayBandHTML() {
  const left = dayIndex(HOLIDAY_WINDOW.start, axisStart) * state.pxPerDay;
  const width = (dayIndex(HOLIDAY_WINDOW.end, axisStart) - dayIndex(HOLIDAY_WINDOW.start, axisStart) + 1) * state.pxPerDay;
  if (width <= 0) return "";
  return `<div class="holiday-band" style="left:${left}px;width:${width}px" title="Holiday period — all phases pause"></div>`;
}

// ---------- header timeline (months + trench brackets + gridlines) ----------
function renderHead() {
  const timelineW = totalDays * state.pxPerDay;
  document.documentElement.style.setProperty("--label-w", LABEL_W + "px");
  document.documentElement.style.setProperty("--timeline-w", timelineW + "px");

  // month segments
  const months = [];
  let cur = new Date(axisStart);
  cur.setDate(1);
  while (cur < axisEnd) {
    const next = new Date(cur.getFullYear(), cur.getMonth() + 1, 1);
    const segStart = cur < axisStart ? axisStart : cur;
    const left = Math.max(0, (segStart - axisStart) / DAY_MS) * state.pxPerDay;
    const width = (Math.min(next, axisEnd) - segStart) / DAY_MS * state.pxPerDay;
    months.push({ label: cur.toLocaleDateString("en-GB", { month: "short", year: "numeric" }), left, width });
    cur = next;
  }

  const trenchRows = Object.entries(TRENCH_WINDOWS).map(([name, w], i) => {
    const left = dayIndex(w.start, axisStart) * state.pxPerDay;
    const width = (dayIndex(w.end, axisStart) - dayIndex(w.start, axisStart) + 1) * state.pxPerDay;
    const color = `var(--trench-${i + 1})`;
    const bracket = `<div class="trench-bracket" style="left:${left}px;width:${Math.max(width,40)}px;background:${color}">${name}</div>`;
    return `<div class="trench-subrow">${bracket}</div>`;
  }).join("");

  const gridlines = [];
  for (let d = 0; d <= totalDays; d += 7) {
    gridlines.push(`<div class="gridline" style="left:${d * state.pxPerDay}px"></div>`);
  }
  for (const m of months) {
    gridlines.push(`<div class="gridline month" style="left:${m.left}px"></div>`);
  }

  document.getElementById("headRow").innerHTML = `
      <div class="head-corner">Domain / Tranche / Tech Area / Application</div>
      <div class="head-timeline" style="width:${timelineW}px">
        ${holidayBandHTML()}
        <div class="month-row">
          ${months.map(m => `<div class="month-lbl" style="left:${m.left}px;width:${m.width}px">${m.label}</div>`).join("")}
        </div>
        <div class="trench-row">${trenchRows}</div>
        <div class="gridlines">${gridlines.join("")}</div>
      </div>`;
}

// ---------- body rows ----------
function addDaysISO(s, n) {
  const d = toDate(s);
  d.setTime(d.getTime() + n * DAY_MS);
  return d.toISOString().slice(0, 10);
}
function singleBar(cls, s, e, overrun) {
  const left = dayIndex(s, axisStart) * state.pxPerDay;
  const width = Math.max(1.5, (dayIndex(e, axisStart) - dayIndex(s, axisStart) + 1) * state.pxPerDay);
  return `<div class="bar ${cls}${overrun ? " overrun" : ""}" style="left:${left}px;width:${width}px" tabindex="0"></div>`;
}
function phaseBar(cls, s, e, overrun) {
  // Split the bar into two segments when the phase's window straddles the holiday
  // (it legitimately runs before the holiday, pauses, then resumes after it).
  const overlapsHoliday = s <= HOLIDAY_WINDOW.end && e >= HOLIDAY_WINDOW.start;
  if (!overlapsHoliday) {
    return singleBar(cls, s, e, overrun);
  }
  let bars = "";
  if (s < HOLIDAY_WINDOW.start) {
    bars += singleBar(cls, s, addDaysISO(HOLIDAY_WINDOW.start, -1), false);
  }
  if (e > HOLIDAY_WINDOW.end) {
    bars += singleBar(cls, addDaysISO(HOLIDAY_WINDOW.end, 1), e, overrun);
  }
  return bars;
}

function renderBody() {
  const timelineW = totalDays * state.pxPerDay;
  const rows = [];
  let anyVisible = false;
  const holidayBand = holidayBandHTML();
  const filterActive = isFilterActive();

  for (const domain of domainOrder) {
    const trenchMap = domainMap.get(domain);
    const domainApps = [];
    for (const [, techAreaMap] of trenchMap) domainApps.push(...trenchApps(techAreaMap));
    const domainVisible = domainApps.filter(matches);
    if (domainVisible.length === 0 && filterActive) continue;

    const domainCollapsed = state.collapsedDomains.has(domain);
    rows.push(`
      <div class="row group domain ${domainCollapsed ? "collapsed" : ""}" data-domain="${escAttr(domain)}" style="width:${LABEL_W + timelineW}px">
        <div class="band"></div>
        <div class="group-label"><span class="chev">▾</span>${escHtml(domain)} <span class="count">(${domainVisible.length}${domainVisible.length !== domainApps.length ? " of " + domainApps.length : ""} applications)</span></div>
      </div>`);
    if (domainCollapsed) continue;

    for (const [trench, techAreaMap] of trenchMap) {
      const list = trenchApps(techAreaMap);
      const visible = list.filter(matches);
      if (visible.length === 0 && filterActive) continue;
      const key = domain + "||" + trench;
      const trenchCollapsed = state.collapsedTrenches.has(key);
      const win = TRENCH_WINDOWS[trench];
      rows.push(`
        <div class="row group trench ${trenchCollapsed ? "collapsed" : ""}" data-domain="${escAttr(domain)}" data-trench="${escAttr(trench)}" style="width:${LABEL_W + timelineW}px">
          <div class="band"></div>
          <div class="group-label"><span class="chev">▾</span>${escHtml(trench)} <span class="count">(${visible.length}${visible.length !== list.length ? " of " + list.length : ""})</span>${win ? ` <span class="count">— ${fmtShort(win.start)} to ${fmtShort(win.end)}</span>` : ""}</div>
        </div>`);
      if (trenchCollapsed) continue;

      const taEntries = [...techAreaMap.entries()].sort((x, y) => x[0].localeCompare(y[0]));
      for (const [techArea, taList] of taEntries) {
        const taVisible = taList.filter(matches);
        if (taVisible.length === 0 && filterActive) continue;
        const taKey = domain + "||" + trench + "||" + techArea;
        const taCollapsed = state.collapsedTechAreas.has(taKey);
        rows.push(`
          <div class="row group techarea ${taCollapsed ? "collapsed" : ""}" data-domain="${escAttr(domain)}" data-trench="${escAttr(trench)}" data-techarea="${escAttr(techArea)}" style="width:${LABEL_W + timelineW}px">
            <div class="band"></div>
            <div class="group-label"><span class="chev">▾</span>${escHtml(techArea)} <span class="count">(${taVisible.length}${taVisible.length !== taList.length ? " of " + taList.length : ""})</span></div>
          </div>`);
        if (taCollapsed) continue;

        for (const a of taList) {
          const isVisible = matches(a);
          anyVisible = anyVisible || isVisible;
          const hclPresent = isHclPresent(a);
          rows.push(`
            <div class="row app${isVisible ? "" : " dim"}${hclPresent ? " hcl-present" : ""}${a.rebadge_flag ? " rebadge-flag" : ""}" data-idx="${a._idx}">
              <div class="label-cell">
                <span class="app-name">${escHtml(a.name)}</span>
                <span class="complexity-pill ${a.complexity}">${a.complexity}</span>
                <span class="apm-id">${escHtml(a.apm || "")}</span>
              </div>
              <div class="timeline-cell" style="width:${timelineW}px">
                ${holidayBand}
                ${phaseBar("pre", a.pre_s, a.pre_e)}
                ${phaseBar("ab", a.ab_s, a.ab_e)}
                ${phaseBar("rep", a.rep_s, a.rep_e)}
                ${phaseBar("obs", a.obs_s, a.obs_e, a.overrun > 0)}
              </div>
            </div>`);
        }
      }
    }
  }

  document.getElementById("ganttBody").innerHTML = rows.join("");
  document.getElementById("ganttBody").style.width = (LABEL_W + timelineW) + "px";
  document.getElementById("emptyState").hidden = rows.length > 0;
  renderGanttStats();
}

function escHtml(s) { return String(s).replace(/[&<>]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c])); }
function escAttr(s) { return escHtml(s).replace(/"/g, "&quot;"); }

function rerender() { renderHead(); renderBody(); }

