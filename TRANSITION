// Resolve each session's Tranche from the master RAW dataset (this dashboard's single
// source of truth), rather than guessing — a session is only ever assigned a Tranche when
// the data actually supports it:
//   1. exact App Id (APM) match against RAW
//   2. exact Application name match against RAW, when it resolves to exactly one Tranche
//   3. the session's Domain, only for domains where every real application sits in one
//      single Tranche (so the fallback can't be wrong)
// A session that matches none of these gets trench = null and is only ever shown under
// "All tranches" — it is never guessed into a specific one.
const RAW_BY_APM = new Map();
const RAW_BY_NAME = new Map();
for (const a of RAW) {
  if (a.apm && a.apm !== "N/A") RAW_BY_APM.set(a.apm, a);
  const key = a.name.trim().toLowerCase();
  if (!RAW_BY_NAME.has(key)) RAW_BY_NAME.set(key, []);
  RAW_BY_NAME.get(key).push(a);
}
const SESSION_DOMAIN_SINGLE_TRENCH = {
  "NZ": "Tranche 1", "Arch & Eng": "Tranche 1",
  "Payments": "Tranche 3", "Security": "Tranche 3",
};
function resolveSessionTrench(s) {
  if (s.app_id && RAW_BY_APM.has(s.app_id)) return RAW_BY_APM.get(s.app_id).trench;
  const matches = RAW_BY_NAME.get((s.application || "").trim().toLowerCase());
  if (matches && matches.length) {
    const trenches = new Set(matches.map(m => m.trench));
    if (trenches.size === 1) return matches[0].trench;
  }
  return SESSION_DOMAIN_SINGLE_TRENCH[s.domain] || null;
}
for (const s of SESSIONS) s.trench = resolveSessionTrench(s);

const sessionDomainOrder = [];
for (const s of SESSIONS) if (!sessionDomainOrder.includes(s.domain)) sessionDomainOrder.push(s.domain);
const sessionsByDomain = new Map();
for (const s of SESSIONS) {
  if (!sessionsByDomain.has(s.domain)) sessionsByDomain.set(s.domain, []);
  sessionsByDomain.get(s.domain).push(s);
}
for (const [, list] of sessionsByDomain) list.sort((a, b) => (a.date || "").localeCompare(b.date || ""));

const sessionState = { search: "", domain: "", status: "", trench: "", collapsedDomains: new Set() };

function sessionMatches(s) {
  if (sessionState.domain && s.domain !== sessionState.domain) return false;
  if (sessionState.status && s.status !== sessionState.status) return false;
  if (sessionState.trench && s.trench !== sessionState.trench) return false;
  if (sessionState.search) {
    const q = sessionState.search.toLowerCase();
    const hay = [s.application, s.title, s.anz_attendees, s.hcl_attendees, s.summary, s.tech_area, s.app_id]
      .join(" ").toLowerCase();
    if (!hay.includes(q)) return false;
  }
  return true;
}

fillSelect(document.getElementById("sessionTrenchSelect"), Object.keys(TRENCH_WINDOWS));
fillSelect(document.getElementById("sessionDomainSelect"), sessionDomainOrder);
fillSelect(document.getElementById("sessionStatusSelect"), [...new Set(SESSIONS.map(s => s.status))]);

function sessionStatusClass(s) { return "status-" + s.replace(/\s+/g, "-"); }

function fmtSessionDate(iso) {
  if (!iso) return "—";
  return toDate(iso).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
}

function renderSessions() {
  const rows = [];
  const anyFilterActive = !!(sessionState.domain || sessionState.status || sessionState.search);

  for (const domain of sessionDomainOrder) {
    const list = sessionsByDomain.get(domain);
    const visible = list.filter(sessionMatches);
    if (visible.length === 0 && anyFilterActive) continue;
    const collapsed = sessionState.collapsedDomains.has(domain);
    const totalMins = list.reduce((sum, s) => sum + (s.duration || 0), 0);
    rows.push(`
      <div class="session-domain-header ${collapsed ? "collapsed" : ""}" data-domain="${escAttr(domain)}">
        <span class="chev">▾</span>${escHtml(domain)}
        <span class="count">(${visible.length}${visible.length !== list.length ? " of " + list.length : ""} sessions · ${Math.round(totalMins / 60 * 10) / 10} hrs KT)</span>
      </div>`);
    if (collapsed) continue;

    for (const s of list) {
      const isVisible = sessionMatches(s);
      const hasArtifacts = s.artifacts_generated && s.artifacts_generated.trim();
      rows.push(`
        <div class="session-card${isVisible ? "" : " dim"}">
          <div class="session-head">
            <span class="session-num">#${s.sno}</span>
            <span class="session-date">${fmtSessionDate(s.date)} · ${escHtml(s.time)}</span>
            <span class="session-domain-pill">${escHtml(s.domain)}</span>
            ${s.trench ? `<span class="session-domain-pill trench">${escHtml(s.trench)}</span>` : ""}
            <span class="pill ${sessionStatusClass(s.status)}">${escHtml(s.status)}</span>
          </div>
          <div class="session-title">${escHtml(s.title)}</div>
          <div class="session-app">${escHtml(s.application)}${s.app_id ? `<span class="apm-chip">${escHtml(s.app_id)}</span>` : ""}${s.tech_area ? " · " + escHtml(s.tech_area) : ""}</div>
          <div class="session-grid">
            <div>
              <div class="session-label">ANZ Attendees</div>
              <div class="session-value">${escHtml(s.anz_attendees || "—")}</div>
              <div class="session-label">HCL Attendees</div>
              <div class="session-value">${escHtml(s.hcl_attendees || "—")}</div>
            </div>
            <div>
              <div class="session-label">KT Session Summary</div>
              <div class="session-value">${escHtml(s.summary || "—")}</div>
            </div>
          </div>
          <div class="session-foot">
            <span>⏱ ${s.duration || 0} min</span>
            <span class="${hasArtifacts ? "" : "empty"}">📎 ${hasArtifacts ? escHtml(s.artifacts_generated.replace(/\n/g, ", ").replace(/^\d+\.\s*/, "").replace(/\d+\.\s*/g, "")) : "No artifacts yet"}</span>
            ${s.artifacts_reviewed_by ? `<span>Reviewed by ${escHtml(s.artifacts_reviewed_by)}</span>` : ""}
          </div>
        </div>`);
    }
  }

  document.getElementById("sessionBody").innerHTML = rows.join("");
  document.getElementById("sessionEmptyState").hidden = rows.length > 0;
  renderSessionStats();
}

function renderSessionStats() {
  const filterActive = !!(sessionState.domain || sessionState.status || sessionState.search);
  const matched = filterActive ? SESSIONS.filter(sessionMatches) : SESSIONS;
  const completed = matched.filter(s => s.status === "Completed").length;
  const totalHrs = Math.round(matched.reduce((sum, s) => sum + (s.duration || 0), 0) / 60 * 10) / 10;
  const domainsMatched = new Set(matched.map(s => s.domain)).size;
  const chips = [
    { n: filterActive ? `${matched.length} / ${SESSIONS.length}` : SESSIONS.length, l: filterActive ? "Sessions matching filters" : "Sessions", cls: filterActive ? "filtered" : "" },
    { n: filterActive ? domainsMatched : sessionDomainOrder.length, l: "Domains" },
    { n: completed, l: "Completed" },
    { n: totalHrs, l: "KT Hours Logged" },
  ];
  document.getElementById("statRow").innerHTML = chips.map(c =>
    `<div class="stat-chip ${c.cls || ""}"><span class="n">${c.n}</span><span class="l">${c.l}</span></div>`
  ).join("");
}

document.getElementById("sessionSearchInput").addEventListener("input", e => { sessionState.search = e.target.value; renderSessions(); });
document.getElementById("sessionTrenchSelect").addEventListener("change", e => { sessionState.trench = e.target.value; renderSessions(); });
document.getElementById("sessionDomainSelect").addEventListener("change", e => { sessionState.domain = e.target.value; renderSessions(); });
document.getElementById("sessionStatusSelect").addEventListener("change", e => { sessionState.status = e.target.value; renderSessions(); });
document.getElementById("sessionExpandAllBtn").addEventListener("click", () => { sessionState.collapsedDomains.clear(); renderSessions(); });
document.getElementById("sessionCollapseAllBtn").addEventListener("click", () => {
