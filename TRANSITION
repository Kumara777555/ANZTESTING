<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Transition Control Tower</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
  :root {
    color-scheme: light;
    --bg:            #f3f5f8;
    --surface:       #ffffff;
    --surface-alt:   #eef1f5;
    --surface-sunk:  #e7ebf0;
    --ink-primary:   #101c29;
    --ink-secondary: #4d5c6c;
    --ink-muted:     #8993a1;
    --line:          #dde3e9;
    --line-strong:   #c7d0d9;
    --accent:        #1f3a5f;
    --accent-ink:    #ffffff;
    --accent-soft:   #e5ebf3;
    --accent-soft-ink: #1f3a5f;
    --focus:         #2a78d6;
    --header-bg:     #1f3a5f;
    --header-ink:    #ffffff;
    --header-ink-dim: rgba(255,255,255,0.78);
    --header-chip-bg: rgba(255,255,255,0.12);
    --header-chip-line: rgba(255,255,255,0.20);

    --phase-pre:   #86b6ef;
    --phase-ab:    #5598e7;
    --phase-rep:   #2a78d6;
    --phase-obs:   #e8960a;
    --status-critical: #d03b3b;
    --status-critical-soft: #fbe4e4;
    --status-warning: #fab219;
    --status-good: #0ca30c;
    --rr-high: #af5a12;

    --trench-1: #2a78d6;
    --trench-2: #4a3aa7;
    --trench-3: #1baf7a;

    --font-ui: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg:            #0c1015;
      --surface:       #131820;
      --surface-alt:   #1a212b;
      --surface-sunk:  #0f141a;
      --ink-primary:   #f0f4f8;
      --ink-secondary: #a9b6c4;
      --ink-muted:     #6c7a89;
      --line:          #26303b;
      --line-strong:   #34404c;
      --accent:        #4d7fb5;
      --accent-ink:    #08111c;
      --accent-soft:   #1c2836;
      --accent-soft-ink: #9fc1e6;
      --focus:         #3987e5;
      --header-bg:     #10161f;
      --header-ink:    #f0f4f8;
      --header-ink-dim: #8fa0b3;
      --header-chip-bg: #1a2331;
      --header-chip-line: #2b3947;

      --phase-pre:   #3987e5;
      --phase-ab:    #256abf;
      --phase-rep:   #184f95;
      --phase-obs:   #d9860a;
      --status-critical: #e66767;
      --status-critical-soft: #3a1f22;
      --status-warning: #fab219;
      --status-good: #0ca30c;
      --rr-high: #f0a25e;

      --trench-1: #3987e5;
      --trench-2: #9085e9;
      --trench-3: #199e70;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg:            #0c1015;
    --surface:       #131820;
    --surface-alt:   #1a212b;
    --surface-sunk:  #0f141a;
    --ink-primary:   #f0f4f8;
    --ink-secondary: #a9b6c4;
    --ink-muted:     #6c7a89;
    --line:          #26303b;
    --line-strong:   #34404c;
    --accent:        #4d7fb5;
    --accent-ink:    #08111c;
    --accent-soft:   #1c2836;
    --accent-soft-ink: #9fc1e6;
    --focus:         #3987e5;
    --header-bg:     #10161f;
    --header-ink:    #f0f4f8;
    --header-ink-dim: #8fa0b3;
    --header-chip-bg: #1a2331;
    --header-chip-line: #2b3947;

    --phase-pre:   #3987e5;
    --phase-ab:    #256abf;
    --phase-rep:   #184f95;
    --phase-obs:   #d9860a;
    --status-critical: #e66767;
    --status-critical-soft: #3a1f22;
    --status-warning: #fab219;
    --status-good: #0ca30c;
    --rr-high: #f0a25e;

    --trench-1: #3987e5;
    --trench-2: #9085e9;
    --trench-3: #199e70;
  }

  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink-primary);
    font-family: var(--font-ui);
    font-size: 13px;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--focus); color: #fff; }
  button, select, input { font-family: inherit; font-size: inherit; color: inherit; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

  .app-shell { display: flex; flex-direction: column; height: 100vh; }

  /* ---------- Header ---------- */
  header.top {
    flex: 0 0 auto;
    background: var(--header-bg);
    color: var(--header-ink);
    padding: 18px 24px 16px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--header-chip-line);
  }
  .title-block h1 {
    margin: 0 0 3px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.2px;
    text-wrap: balance;
    color: var(--header-ink);
  }
  .title-block p {
    margin: 0;
    font-size: 12.5px;
    color: var(--header-ink-dim);
    max-width: 62ch;
  }
  .stat-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .stat-chip {
    background: var(--header-chip-bg);
    border: 1px solid var(--header-chip-line);
    border-radius: 8px;
    padding: 6px 12px;
    min-width: 84px;
  }
  .stat-chip .n {
    display: block;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 17px;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    color: var(--header-ink);
  }
  .stat-chip .l {
    display: block;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--header-ink-dim);
    margin-top: 2px;
  }
  .stat-chip.critical .n { color: var(--status-critical); }
  .stat-chip.good .n { color: var(--status-good); }
  .stat-chip.filtered { border-color: var(--focus); background: color-mix(in srgb, var(--focus) 18%, var(--header-chip-bg)); }
  .stat-chip.filtered .n { color: #fff; }

  /* ---------- Toolbar ---------- */
  .toolbar {
    flex: 0 0 auto;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding: 10px 24px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .field { display: flex; flex-direction: column; gap: 3px; }
  .field label {
    font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px;
    color: var(--ink-muted); font-weight: 500;
  }
  .field input[type="search"], .field select {
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 6px 9px;
    color: var(--ink-primary);
  }
  .field input[type="search"] { width: 210px; }
  .field select { min-width: 118px; }
  .toolbar-divider { width: 1px; align-self: stretch; background: var(--line); margin: 0 2px; }

  .toggle-btn {
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 6px 11px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-secondary);
    white-space: nowrap;
  }
  .toggle-btn:hover { background: var(--surface-sunk); }
  .toggle-btn[aria-pressed="true"] {
    background: var(--accent-soft);
    color: var(--accent-soft-ink);
    border-color: var(--accent-soft-ink);
  }
  .seg { display: flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .seg button {
    background: var(--surface-alt); border: none; padding: 6px 10px; cursor: pointer;
    color: var(--ink-secondary); border-right: 1px solid var(--line);
  }
  .seg button:last-child { border-right: none; }
  .seg button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }

  .legend { display: flex; align-items: center; gap: 14px; margin-left: auto; flex-wrap: wrap; }
  .legend .item { display: flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--ink-secondary); }
  .legend .swatch { width: 11px; height: 11px; border-radius: 3px; flex: none; }
  .legend .swatch.critical { border-radius: 50%; }

  /* ---------- Tabs ---------- */
  .tabbar {
    flex: 0 0 auto;
    display: flex;
    gap: 4px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding: 0 24px;
  }
  .tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 4px;
    margin: 0 14px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-muted);
    cursor: pointer;
  }
  .tab:hover { color: var(--ink-secondary); }
  .tab[aria-selected="true"] { color: var(--ink-primary); border-bottom-color: var(--accent); }
  .view { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }
  .view[hidden] { display: none; }

  /* ---------- Actions & Dependencies view ---------- */
  .actions-scroll { flex: 1 1 auto; overflow: auto; background: var(--surface); }
  .actions-body { display: flex; flex-direction: column; }
  .phase-header {
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    font-size: 12.5px;
    padding: 8px 16px;
    display: flex;
    align-items: baseline;
    gap: 8px;
    cursor: pointer;
    position: sticky;
    top: 0;
    z-index: 2;
  }
  .phase-header .chev { display: inline-block; transition: transform 0.15s ease; font-size: 10px; }
  .phase-header.collapsed .chev { transform: rotate(-90deg); }
  .phase-header .sub { font-weight: 400; opacity: 0.78; font-size: 11.5px; }
  .phase-header .count { font-weight: 400; opacity: 0.78; }

  .action-row {
    display: grid;
    grid-template-columns: 34px 1.6fr 150px 92px 84px 82px 100px 1.4fr;
    gap: 10px;
    align-items: center;
    padding: 9px 16px;
    border-bottom: 1px solid var(--line);
  }
  .action-row:hover { background: var(--surface-alt); }
  .action-row.dim { opacity: 0.35; }
  .action-row .num { color: var(--ink-muted); font-family: var(--font-mono); font-size: 11.5px; }
  .action-row .action-main .action-text { font-weight: 500; }
  .action-row .action-main .category { display: block; font-size: 10.5px; color: var(--ink-muted); margin-top: 2px; text-transform: uppercase; letter-spacing: 0.4px; }
  .action-row .owner { font-size: 12px; color: var(--ink-secondary); }
  .action-row .due { font-family: var(--font-mono); font-size: 12px; font-variant-numeric: tabular-nums; }
  .action-row .due.overdue { color: var(--status-critical); font-weight: 600; }
  .action-row .notes { font-size: 11.5px; color: var(--ink-secondary); }

  .pill { display: inline-flex; align-items: center; gap: 4px; font-size: 10.5px; font-weight: 600; padding: 2px 8px; border-radius: 999px; white-space: nowrap; }
  .pill.urgency-High { background: color-mix(in srgb, var(--status-critical) 20%, transparent); color: color-mix(in srgb, var(--status-critical) 85%, var(--ink-primary)); }
  .pill.urgency-Medium { background: color-mix(in srgb, var(--status-warning) 26%, transparent); color: color-mix(in srgb, var(--status-warning) 60%, var(--ink-primary)); }
  .pill.urgency-Low { background: color-mix(in srgb, var(--status-good) 20%, transparent); color: color-mix(in srgb, var(--status-good) 80%, var(--ink-primary)); }
  .pill.status-Not-Started { background: var(--surface-sunk); color: var(--ink-secondary); }
  .pill.status-In-Progress { background: color-mix(in srgb, var(--status-warning) 26%, transparent); color: color-mix(in srgb, var(--status-warning) 60%, var(--ink-primary)); }
  .pill.status-Done { background: color-mix(in srgb, var(--status-good) 20%, transparent); color: color-mix(in srgb, var(--status-good) 80%, var(--ink-primary)); }
  .pill.status-Completed { background: color-mix(in srgb, var(--status-good) 20%, transparent); color: color-mix(in srgb, var(--status-good) 80%, var(--ink-primary)); }
  .pill.status-Scheduled { background: color-mix(in srgb, var(--status-warning) 26%, transparent); color: color-mix(in srgb, var(--status-warning) 60%, var(--ink-primary)); }
  .pill.overdue-flag { background: color-mix(in srgb, var(--status-critical) 20%, transparent); color: color-mix(in srgb, var(--status-critical) 85%, var(--ink-primary)); }

  .ready-track { position: relative; height: 6px; border-radius: 3px; background: var(--surface-sunk); overflow: hidden; }
  .ready-fill { position: absolute; inset: 0; width: 0; background: var(--focus); border-radius: 3px; }
  .ready-label { font-size: 10.5px; color: var(--ink-muted); margin-top: 3px; font-family: var(--font-mono); }
  .ready-na { font-size: 11px; color: var(--ink-muted); }

  /* ---------- Gantt grid ---------- */
  .gantt-scroll {
    flex: 1 1 auto;
    overflow: auto;
    position: relative;
    background: var(--surface);
  }
  .gantt-body { position: relative; }

  .row {
    display: flex;
    height: 26px;
    border-bottom: 1px solid var(--line);
  }
  .row.app:hover { background: var(--surface-alt); }
  .row.app.dim { opacity: 0.32; }
  .row.app.hcl-present { background: color-mix(in srgb, var(--status-good) 7%, transparent); }
  .row.app.hcl-present:hover { background: color-mix(in srgb, var(--status-good) 14%, var(--surface-alt)); }
  .row.app.rebadge-flag { background: color-mix(in srgb, var(--focus) 14%, transparent); }
  .row.app.rebadge-flag:hover { background: color-mix(in srgb, var(--focus) 22%, var(--surface-alt)); }

  .label-cell {
    position: sticky;
    left: 0;
    z-index: 3;
    width: var(--label-w);
    flex: 0 0 var(--label-w);
    background: var(--surface);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    border-right: 1px solid var(--line-strong);
    border-left: 3px solid transparent;
    overflow: hidden;
  }
  .row.app:hover .label-cell { background: var(--surface-alt); }
  .row.app.hcl-present .label-cell {
    background: color-mix(in srgb, var(--status-good) 7%, var(--surface));
    border-left-color: var(--status-good);
  }
  .row.app.hcl-present:hover .label-cell { background: color-mix(in srgb, var(--status-good) 14%, var(--surface-alt)); }
  .row.app.hcl-present .apm-id { color: color-mix(in srgb, var(--status-good) 75%, var(--ink-primary)); font-weight: 600; }
  .row.app.rebadge-flag .label-cell {
    background: color-mix(in srgb, var(--focus) 14%, var(--surface));
    border-left-color: var(--focus);
  }
  .row.app.rebadge-flag:hover .label-cell { background: color-mix(in srgb, var(--focus) 22%, var(--surface-alt)); }
  .row.app.rebadge-flag .apm-id { color: color-mix(in srgb, var(--focus) 80%, var(--ink-primary)); font-weight: 600; }

  .app-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1 1 auto;
    min-width: 0;
    cursor: help;
  }
  .app-name:hover { text-decoration: underline dotted; text-underline-offset: 2px; }
  .complexity-pill {
    flex: none;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 999px;
    letter-spacing: 0.2px;
  }
  .complexity-pill.High { background: color-mix(in srgb, var(--status-critical) 20%, transparent); color: color-mix(in srgb, var(--status-critical) 85%, var(--ink-primary)); }
  .complexity-pill.Medium { background: color-mix(in srgb, var(--status-warning) 26%, transparent); color: color-mix(in srgb, var(--status-warning) 60%, var(--ink-primary)); }
  .complexity-pill.Low { background: color-mix(in srgb, var(--status-good) 20%, transparent); color: color-mix(in srgb, var(--status-good) 80%, var(--ink-primary)); }

  .hcl-type-pill {
    flex: none;
    font-size: 9.5px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 999px;
    letter-spacing: 0.2px;
    max-width: 92px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    background: color-mix(in srgb, var(--status-good) 22%, transparent);
    color: color-mix(in srgb, var(--status-good) 85%, var(--ink-primary));
  }

  .apm-id {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-muted);
    width: 74px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .timeline-cell {
    position: relative;
    flex: none;
    width: var(--timeline-w);
    height: 100%;
  }

  .bar {
    position: absolute;
    top: 5px;
    height: 16px;
    border-radius: 4px;
    cursor: pointer;
  }
  .bar:first-child { border-top-left-radius: 4px; border-bottom-left-radius: 4px; }
  .bar.pre  { background: var(--phase-pre); }
  .bar.ab   { background: var(--phase-ab); }
  .bar.rep  { background: var(--phase-rep); }
  .bar.obs  { background: var(--phase-obs); }
  .bar.overrun::after {
    content: "";
    position: absolute;
    top: -3px; bottom: -3px; right: -3px;
    width: 3px;
    background: var(--status-critical);
    border-radius: 2px;
  }
  .bar:hover, .bar:focus-visible { filter: brightness(1.12); outline: 2px solid color-mix(in srgb, var(--ink-primary) 35%, transparent); outline-offset: 1px; }

  /* group rows (domain / trench) */
  .row.group {
    position: relative;
    cursor: pointer;
  }
  .row.group .band {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .row.group.domain .band { background: var(--accent); }
  .row.group.trench .band { background: var(--surface-sunk); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .row.group.techarea .band { background: var(--surface); border-bottom: 1px solid var(--line); }
  .row.group .group-label {
    position: sticky;
    left: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px 0 14px;
    height: 100%;
    white-space: nowrap;
    font-weight: 600;
  }
  .row.group.domain .group-label { color: #fff; font-size: 12.5px; }
  .row.group.trench .group-label { color: var(--ink-secondary); font-size: 11.5px; padding-left: 30px; }
  .row.group.techarea .group-label { color: var(--ink-muted); font-size: 11px; font-weight: 500; padding-left: 46px; }
  .row.group.techarea .group-label .count { color: var(--ink-muted); }
  .row.group .chev {
    display: inline-block;
    transition: transform 0.15s ease;
    font-size: 10px;
    width: 10px;
  }
  .row.group.collapsed .chev { transform: rotate(-90deg); }
  .row.group .count { font-weight: 400; opacity: 0.75; }

  /* ---------- Timeline header ---------- */
  .head-row { position: sticky; top: 0; z-index: 4; display: flex; background: var(--surface); }
  .head-corner {
    position: sticky; left: 0; top: 0; z-index: 5;
    width: var(--label-w); flex: 0 0 var(--label-w);
    background: var(--surface);
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    display: flex; align-items: flex-end; padding: 0 10px 6px;
    font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--ink-muted);
  }
  .head-timeline {
    position: relative;
    flex: none;
    width: var(--timeline-w);
    border-bottom: 1px solid var(--line-strong);
  }
  .month-row { position: relative; height: 20px; border-bottom: 1px solid var(--line); }
  .month-lbl {
    position: absolute; top: 0; height: 100%; display: flex; align-items: center;
    font-size: 10.5px; font-weight: 600; color: var(--ink-secondary);
    padding-left: 6px; border-left: 1px solid var(--line-strong); box-sizing: border-box;
  }
  .trench-row { position: relative; display: flex; flex-direction: column; }
  .trench-subrow { position: relative; height: 17px; }
  .trench-subrow + .trench-subrow { border-top: 1px solid var(--line); }
  .trench-bracket {
    position: absolute; top: 2.5px; height: 12px; border-radius: 6px;
    display: flex; align-items: center; padding: 0 8px; font-size: 9.5px; font-weight: 600;
    color: #fff; white-space: nowrap; overflow: hidden;
  }
  .gridlines { position: absolute; inset: 0; pointer-events: none; }
  .gridline { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--line); }
  .gridline.month { background: var(--line-strong); }

  .holiday-band {
    position: absolute;
    top: 0; bottom: 0;
    pointer-events: none;
    background: repeating-linear-gradient(45deg,
      color-mix(in srgb, var(--ink-secondary) 16%, transparent) 0 6px,
      color-mix(in srgb, var(--ink-secondary) 8%, transparent) 6px 12px);
    border-left: 1px dashed var(--line-strong);
    border-right: 1px dashed var(--line-strong);
  }
  .head-timeline .holiday-band { top: 0; bottom: 0; z-index: 0; }
  .head-timeline .month-row, .head-timeline .trench-row, .head-timeline .gridlines { position: relative; z-index: 1; }
  .today-line { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--focus); }

  /* ---------- Tooltip ---------- */
  #tooltip {
    position: fixed;
    z-index: 50;
    max-width: 280px;
    background: var(--ink-primary);
    color: var(--bg);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 11.5px;
    line-height: 1.5;
    pointer-events: none;
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.1s ease, transform 0.1s ease;
  }
  #tooltip.show { opacity: 1; transform: translateY(0); }
  #tooltip .tt-title { font-weight: 600; font-size: 12.5px; margin-bottom: 4px; }
  #tooltip .tt-row { display: flex; justify-content: space-between; gap: 14px; }
  #tooltip .tt-row + .tt-row { margin-top: 1px; }
  #tooltip .tt-key { opacity: 0.68; }
  #tooltip .tt-val { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  #tooltip .tt-phase { display: flex; align-items: center; gap: 5px; margin: 6px 0 3px; font-weight: 600; }
  #tooltip .tt-dot { width: 8px; height: 8px; border-radius: 2px; }
  #tooltip .tt-warn { margin-top: 6px; color: #ffb4b4; font-weight: 600; }

  .empty-state {
    padding: 60px 24px; text-align: center; color: var(--ink-muted); font-size: 13px;
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  /* ---------- Integrated Transition Plan on Page (embedded interactive page) ---------- */
  /* Everything below is namespaced with a tpop- prefix (classes, ids, and CSS custom
     properties) and scoped to .tpop-embed, so it cannot collide with any rule above. */
  .tpop-embed{
    color-scheme: light;
    --tpop-paper:       #f5f8fc;
    --tpop-surface:     #ffffff;
    --tpop-surface-2:   #eef2f9;
    --tpop-surface-3:   #e5eaf3;
    --tpop-ink:         #0b1220;
    --tpop-ink-soft:    #475263;
    --tpop-muted:       #838da0;
    --tpop-line:        #dde3ee;
    --tpop-line-strong: #c7cfde;
    --tpop-border:      rgba(11,18,32,0.10);
    --tpop-shadow:      0 1px 2px rgba(15,23,42,0.04), 0 8px 24px -12px rgba(15,23,42,0.18);

    /* sequential phase ramp — one hue, light -> dark (validated ordinal) */
    --tpop-phase-1: #86b6ef; /* Pre-Transition */
    --tpop-phase-2: #3987e5; /* Absorption */
    --tpop-phase-3: #1c5cab; /* Replication */
    --tpop-phase-4: #0d366b; /* Observation */
    --tpop-phase-1-ink: #0d366b;
    --tpop-phase-2-ink: #ffffff;
    --tpop-phase-3-ink: #ffffff;
    --tpop-phase-4-ink: #ffffff;

    /* tranche identity — fixed categorical order, distinct from phase hue */
    --tpop-tranche-1: #eb6834;
    --tpop-tranche-2: #1baf7a;
    --tpop-tranche-3: #4a3aa7;
    --tpop-tranche-1-tint: #fdeee6;
    --tpop-tranche-2-tint: #e5f6ef;
    --tpop-tranche-3-tint: #ece9f7;

    /* status (fixed, never themed) — used only for the complexity read */
    --tpop-status-good: #0ca30c;
    --tpop-status-warn: #fab219;
    --tpop-status-serious: #ec835a;
    --tpop-status-good-tint: #e8f7e4;
    --tpop-status-warn-tint: #fef3d9;
    --tpop-status-serious-tint: #fce8e0;

    --tpop-holiday-line: rgba(74,58,167,0.28);
    --tpop-holiday-fill: rgba(74,58,167,0.05);
    --tpop-focus: #1c5cab;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]) .tpop-embed{
