// ---------- classify each application as Pre-/Post-Shutdown ----------
// "Shutdown" = the Dec/Jan holiday period (see HOLIDAY_WINDOW, 25-Dec-2026 to 25-Jan-2027).
// An application whose Observation phase ends before the shutdown starts is "Pre-Shutdown"
// (its transition is fully wrapped up before the holiday break); anything ending on or after
// that date is "Post-Shutdown".
const SHUTDOWN_CUTOFF = HOLIDAY_WINDOW.start; // "2026-12-25"
RAW.forEach(a => { a.shutdown_phase = (a.obs_e && a.obs_e < SHUTDOWN_CUTOFF) ? "Pre-Shutdown" : "Post-Shutdown"; });

