// Sourced from Rebadging Data.xlsx ("Vendor 0901" sheet): the distinct APM IDs listed in
// column F ("Associated Apps") for every role whose normalised outcome (column H) is
// "Rebadge", matched here against this dashboard's own APM IDs.
const REBADGE_APM_IDS = new Set(["APM0001457", "APM0001547", "APM0001958", "APM0002011", "APM0002119", "APM0002131", "APM0002181", "APM0002814", "APM0002999", "APM0003060", "APM0003072", "APM0003244", "APM0003346", "APM0003357", "APM0003927", "APM0004300", "APM0004412", "APM0004439", "APM0004756", "APM0005120", "APM0005149", "APM0005809", "APM0006010", "APM0006028", "APM0008416"]);
