    const visible = list.filter(actionMatches);
    if (visible.length === 0 && anyFilterActive) continue;
    const collapsed = actionState.collapsedPhases.has(phase);
    rows.push(`
      <div class="phase-header ${collapsed ? "collapsed" : ""}" data-phase="${escAttr(phase)}">
        <span class="chev">▾</span>${escHtml(phase)}
        <span class="sub">${escHtml(list[0].section || "")}</span>
        <span class="count">(${visible.length}${visible.length !== list.length ? " of " + list.length : ""})</span>
      </div>`);
    if (collapsed) continue;

    for (const a of list) {
      const isVisible = actionMatches(a);
      const overdue = isOverdue(a);
      let readyHtml;
      if (a.pct_ready !== null && a.pct_ready !== undefined && a.pct_ready !== "N/A") {
        const pct = parseInt(a.pct_ready, 10);
        readyHtml = `<div class="ready-track"><div class="ready-fill" style="width:${pct}%"></div></div><div class="ready-label">${pct}%</div>`;
      } else {
        readyHtml = `<div class="ready-na">N/A</div>`;
      }
      rows.push(`
        <div class="action-row${isVisible ? "" : " dim"}">
          <div class="num">${a.num}</div>
          <div class="action-main">
            <span class="action-text">${escHtml(a.action)}</span>
            <span class="category">${escHtml(a.category)}</span>
          </div>
          <div class="owner">${escHtml(a.owner)}</div>
          <div class="due${overdue ? " overdue" : ""}" title="${overdue ? "Overdue" : ""}">${a.due ? fmtDate(a.due) : "—"}</div>
          <div><span class="pill urgency-${a.urgency}">${escHtml(a.urgency)}</span></div>
          <div>${readyHtml}</div>
          <div style="display:flex; flex-direction:column; gap:3px; align-items:flex-start;">
            <span class="pill ${statusClass(a.status)}">${escHtml(a.status)}</span>
            ${overdue ? `<span class="pill overdue-flag">⏰ Overdue</span>` : ""}
          </div>
          <div class="notes">${escHtml(a.notes || "")}</div>
        </div>`);
    }
  }

  document.getElementById("actionsBody").innerHTML = rows.join("");
  document.getElementById("actionsEmptyState").hidden = rows.length > 0;
}

document.getElementById("actionSearchInput").addEventListener("input", e => { actionState.search = e.target.value; renderActions(); });
document.getElementById("phaseSelect").addEventListener("change", e => { actionState.phase = e.target.value; renderActions(); });
document.getElementById("ownerSelect").addEventListener("change", e => { actionState.owner = e.target.value; renderActions(); });
