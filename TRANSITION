// ---------- cascading filters: Tranche -> Domain & Tech Area, Domain -> Tech Area ----------
function domainOptionsFor(trench) {
  if (!trench) return domainOrder;
  const set = new Set();
  for (const a of RAW) {
    if (a.trench === trench) set.add(a.domain);
  }
  return domainOrder.filter(d => set.has(d));
}
function techAreaOptionsFor(domain, trench) {
  const set = new Set();
  for (const a of RAW) {
    if (domain && a.domain !== domain) continue;
    if (trench && a.trench !== trench) continue;
    if (a.tech_area) set.add(a.tech_area);
  }
  return [...set].sort((a, b) => a.localeCompare(b));
}
function refreshDomainSelect() {
  const sel = document.getElementById("domainSelect");
  const options = domainOptionsFor(state.trench);
  const ordered = options.filter(d => d !== "Unassigned").concat(options.includes("Unassigned") ? ["Unassigned"] : []);
  sel.innerHTML = "";
  const allOpt = document.createElement("option");
  allOpt.value = "";
  allOpt.textContent = state.trench ? "All domains in tranche" : "All domains";
  sel.appendChild(allOpt);
  fillSelect(sel, ordered);
  if (state.domain && !ordered.includes(state.domain)) state.domain = "";
  sel.value = state.domain;
}
function refreshTechAreaSelect() {
  const sel = document.getElementById("techAreaSelect");
  const options = techAreaOptionsFor(state.domain, state.trench);
  sel.innerHTML = "";
