<script>
(function(){
  var RR_DATA = JSON.parse(document.getElementById('rr-risk-data').textContent);
  var RR_RISKS = RR_DATA.risks;
  var RR_META = RR_DATA.meta;
  var RR_REPORT_DATE = new Date(RR_META.report_date + 'T00:00:00');

  var RR_RATING_ORDER = ['Critical','High','Medium','Low'];
  var RR_RAG_ORDER = ['Red','Amber','Green'];

  function rrEsc(s){
    if(s===null||s===undefined) return '';
    return String(s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  function rrFmtDate(iso){
    if(!iso) return '—';
    var d = new Date(iso + 'T00:00:00');
    var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return d.getDate() + '-' + months[d.getMonth()] + '-' + d.getFullYear();
  }
  function rrDaysDiff(iso){
    if(!iso) return null;
    var d = new Date(iso + 'T00:00:00');
    return Math.round((d - RR_REPORT_DATE) / 86400000);
  }
  function rrDueLabel(iso){
    var n = rrDaysDiff(iso);
    if(n===null) return '—';
    if(n < 0) return (-n) + 'd overdue';
    if(n === 0) return 'Due today';
    return 'in ' + n + 'd';
  }
  function rrLinesToList(text){
    if(!text) return '<p>—</p>';
    var parts = String(text).split('\n').map(function(s){return s.trim();}).filter(Boolean);
    if(parts.length <= 1) return '<p>' + rrEsc(text) + '</p>';
    return '<ul>' + parts.map(function(p){ return '<li>' + rrEsc(p) + '</li>'; }).join('') + '</ul>';
  }
  function rrRatingVar(rating){
    return rating==='Critical'?'--status-critical':rating==='High'?'--rr-high':rating==='Medium'?'--status-warning':'--status-good';
  }

  var rrState = { search:'', rag:'all', rating:'all', category:'all', sort:'score_desc' };
  var rrExpandedIds = {};
  var rrInited = false;

  function rrComputeStats(){
    var s = {total:RR_RISKS.length, Critical:0, High:0, Medium:0, Low:0, Red:0, Amber:0, Green:0, open:0};
    RR_RISKS.forEach(function(r){
      s[r.rating] = (s[r.rating]||0) + 1;
      s[r.rag] = (s[r.rag]||0) + 1;
      if(r.status === 'Open') s.open++;
    });
    return s;
  }
  function rrRenderStats(){
    var s = rrComputeStats();
    var chips = [
      {key:'all', cls:'total', n:s.total, l:'Total risks'},
      {key:'Critical', cls:'crit', n:s.Critical, l:'Critical'},
      {key:'High', cls:'high', n:s.High, l:'High'},
      {key:'Medium', cls:'med', n:s.Medium, l:'Medium'},
      {key:'Low', cls:'low', n:s.Low, l:'Low'},
      {key:'Red', cls:'crit', n:s.Red, l:'Red RAG'},
      {key:'open', cls:'openn', n:s.open, l:'Open'},
    ];
    document.getElementById('rrStatRow').innerHTML = chips.map(function(c){
      var active = (c.key==='all' && rrState.rating==='all' && rrState.rag==='all') ||
                   (RR_RATING_ORDER.indexOf(c.key)>=0 && rrState.rating===c.key) ||
                   (c.key==='Red' && rrState.rag==='Red');
      return '<div class="rr-stat-chip '+c.cls+(active?' active':'')+'" data-chip="'+c.key+'">'+
             '<span class="n">'+c.n+'</span><span class="l">'+c.l+'</span></div>';
    }).join('');
    document.querySelectorAll('.rr-stat-chip').forEach(function(el){
      el.addEventListener('click', function(){
        var key = el.getAttribute('data-chip');
        if(key==='all'){ rrState.rating='all'; rrState.rag='all'; }
        else if(key==='Red'){ rrState.rag = (rrState.rag==='Red') ? 'all' : 'Red'; }
        else if(key==='open'){ /* no-op */ }
        else { rrState.rating = (rrState.rating===key) ? 'all' : key; }
        rrRenderAll();
      });
    });
  }

  var rrRagSeg, rrRatingSeg, rrCatSel;
  function rrRenderSegs(){
    rrRagSeg.innerHTML = ['all'].concat(RR_RAG_ORDER).map(function(v){
      return '<button data-rag="'+v+'" class="'+(rrState.rag===v?'on':'')+'">'+(v==='all'?'All RAG':v)+'</button>';
    }).join('');
    rrRatingSeg.innerHTML = ['all'].concat(RR_RATING_ORDER).map(function(v){
      return '<button data-rating="'+v+'" class="'+(rrState.rating===v?'on':'')+'">'+(v==='all'?'All ratings':v)+'</button>';
    }).join('');
    rrRagSeg.querySelectorAll('button').forEach(function(b){
      b.addEventListener('click', function(){ rrState.rag = b.getAttribute('data-rag'); rrRenderAll(); });
    });
    rrRatingSeg.querySelectorAll('button').forEach(function(b){
      b.addEventListener('click', function(){ rrState.rating = b.getAttribute('data-rating'); rrRenderAll(); });
    });
  }

  function rrGetFiltered(){
    var list = RR_RISKS.filter(function(r){
      if(rrState.rag!=='all' && r.rag!==rrState.rag) return false;
      if(rrState.rating!=='all' && r.rating!==rrState.rating) return false;
      if(rrState.category!=='all' && r.category!==rrState.category) return false;
      if(rrState.search){
        var hay = (r.risk_id+' '+r.title+' '+r.description+' '+r.owner).toLowerCase();
        if(hay.indexOf(rrState.search)===-1) return false;
      }
      return true;
    });
    list.sort(function(a,b){
      switch(rrState.sort){
        case 'score_asc': return a.score - b.score;
        case 'date_asc': return new Date(a.target_date) - new Date(b.target_date);
        case 'id_asc': return a.risk_id.localeCompare(b.risk_id);
        default: return b.score - a.score;
      }
    });
    return list;
  }

  function rrRiskRowHTML(r){
    var due = rrDueLabel(r.target_date);
    var overdue = rrDaysDiff(r.target_date) !== null && rrDaysDiff(r.target_date) < 0;
    var isOpen = !!rrExpandedIds[r.risk_id];
    var mainRow =
      '<tr class="rr-row'+(isOpen?' expanded':'')+'" data-id="'+rrEsc(r.risk_id)+'">'+
        '<td class="rr-c-rag"><span class="rr-dot '+r.rag+'" title="RAG: '+r.rag+'"></span></td>'+
        '<td class="rr-c-id">'+rrEsc(r.risk_id)+'</td>'+
        '<td class="rr-c-risk">'+
          '<p class="rr-title">'+rrEsc(r.title)+'</p>'+
          '<p class="rr-desc">'+rrEsc(r.description)+'</p>'+
          (r.linked_issue? '<div class="rr-tags"><span class="rr-tag">Linked: '+rrEsc(r.linked_issue)+'</span></div>':'')+
        '</td>'+
        '<td><span class="rr-tag">'+rrEsc(r.category)+'</span></td>'+
        '<td class="rr-c-owner">'+rrEsc(r.owner)+'</td>'+
        '<td class="rr-c-crit"><span class="rr-badge '+r.rating+'">'+r.rating+'</span></td>'+
        '<td class="rr-c-score"><span class="rr-score" style="color:var('+rrRatingVar(r.rating)+')">'+r.score+'</span></td>'+
        '<td class="rr-c-date">'+rrFmtDate(r.date_identified)+'</td>'+
        '<td class="rr-c-date"><span class="v'+(overdue?' overdue':'')+'">'+rrFmtDate(r.target_date)+'</span>'+
          '<span class="due-lbl'+(overdue?' overdue':'')+'">'+due+'</span></td>'+
        '<td class="rr-c-chev"><svg class="rr-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 6l6 6-6 6"/></svg></td>'+
      '</tr>';
    var detailRow =
      '<tr class="rr-detail'+(isOpen?' show':'')+'"><td colspan="10">'+
        '<div class="rr-grid">'+
          '<div class="rr-block"><h4>Mitigation actions ('+rrEsc(r.response_strategy)+')</h4>'+rrLinesToList(r.mitigation)+'</div>'+
          '<div class="rr-block"><h4>Contingency plan</h4>'+rrLinesToList(r.contingency)+'</div>'+
          '<div class="rr-block trigger"><h4>Trigger / early warning</h4><p>'+rrEsc(r.trigger)+'</p></div>'+
        '</div>'+
        '<div class="rr-info-strip">'+
          '<span>Raised by <b>'+rrEsc(r.raised_by)+'</b></span>'+
          '<span>Last updated <b>'+rrFmtDate(r.last_updated)+'</b> by '+rrEsc(r.updated_by)+'</span>'+
          '<span>Customer visible: <b class="'+(r.customer_visible==='Yes'?'rr-flag-yes':'rr-flag-no')+'">'+rrEsc(r.customer_visible)+'</b></span>'+
          '<span>Escalated: <b class="'+(r.escalated==='Yes'?'rr-flag-yes':'rr-flag-no')+'">'+rrEsc(r.escalated)+'</b></span>'+
        '</div>'+
        (r.comments? '<p style="margin-top:10px; font-size:12px; color:var(--ink-secondary); font-style:italic;">"'+rrEsc(r.comments)+'"</p>' : '')+
      '</td></tr>';
    return mainRow + detailRow;
  }

  function rrRenderList(){
    var filtered = rrGetFiltered();
    var tbody = document.getElementById('rrTableBody');
    tbody.innerHTML = filtered.map(rrRiskRowHTML).join('');
    tbody.querySelectorAll('tr.rr-row').forEach(function(tr){
      tr.addEventListener('click', function(){
        var id = tr.getAttribute('data-id');
        rrExpandedIds[id] = !rrExpandedIds[id];
        rrRenderList();
      });
    });
    document.getElementById('rrEmptyState').hidden = filtered.length > 0;
    document.getElementById('rrCountNote').textContent = 'Showing ' + filtered.length + ' of ' + RR_RISKS.length + ' risks';
  }

  function rrRenderAll(){
    rrRenderStats();
    rrRenderSegs();
    rrCatSel.value = rrState.category;
    rrRenderList();
  }

  function rrInit(){
    if(rrInited) return;
    rrInited = true;
    rrRagSeg = document.getElementById('rrRagSeg');
    rrRatingSeg = document.getElementById('rrRatingSeg');
    rrCatSel = document.getElementById('rrCatSel');
    var categories = Array.from(new Set(RR_RISKS.map(function(r){return r.category;}))).sort();
    rrCatSel.innerHTML = '<option value="all">All categories</option>' + categories.map(function(c){
      return '<option value="'+rrEsc(c)+'">'+rrEsc(c)+'</option>';
    }).join('');
    rrCatSel.addEventListener('change', function(){ rrState.category = rrCatSel.value; rrRenderAll(); });
    document.getElementById('rrSearchBox').addEventListener('input', function(e){ rrState.search = e.target.value.toLowerCase(); rrRenderAll(); });
    document.getElementById('rrSortSel').addEventListener('change', function(e){ rrState.sort = e.target.value; rrRenderAll(); });
    document.getElementById('rrFootnote').textContent =
      'Risk Register generated from the RAID Log (Risks tab) as of ' + rrFmtDate(RR_META.report_date) + '. Risk Score = Probability × Impact (1–5 each); Rating bands: 1–4 Low, 5–9 Medium, 10–15 High, 16–25 Critical.';
  }

  window.renderRiskRegister = function(){
    rrInit();
    rrRenderAll();
  };
})();
</script>

</body>
