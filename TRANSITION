// ---------- axis ----------
let axisStartRaw = RAW.reduce((m, a) => a.pre_s < m ? a.pre_s : m, RAW[0].pre_s);
let axisEndRaw = RAW.reduce((m, a) => a.obs_e > m ? a.obs_e : m, RAW[0].obs_e);
let axisStart = toDate(axisStartRaw); // start exactly at the earliest phase date -- no week-backup, so no empty lead-in month appears
let axisEnd = toDate(axisEndRaw);
axisEnd.setDate(axisEnd.getDate() + 10);
const totalDays = Math.ceil((axisEnd - axisStart) / DAY_MS);

// ---------- grouping (preserve source order: domain -> trench -> tech area -> app) ----------
const domainOrder = [];
const domainMap = new Map();
for (const a of RAW) {
  if (!domainMap.has(a.domain)) { domainMap.set(a.domain, new Map()); domainOrder.push(a.domain); }
  const trenchMap = domainMap.get(a.domain);
  if (!trenchMap.has(a.trench)) trenchMap.set(a.trench, new Map());
  const techAreaMap = trenchMap.get(a.trench);
  const ta = a.tech_area || "Unassigned";
  if (!techAreaMap.has(ta)) techAreaMap.set(ta, []);
  techAreaMap.get(ta).push(a);
}
function trenchApps(techAreaMap) {
  const out = [];
  for (const [, list] of techAreaMap) out.push(...list);
  return out;
}

