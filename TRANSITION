    --tpop-phase-1: #9ec5f4;
    --tpop-phase-2: #5598e7;
    --tpop-phase-3: #256abf;
    --tpop-phase-4: #184f95;
    --tpop-phase-1-ink: #0c1a2c;
    --tpop-phase-2-ink: #ffffff;
    --tpop-phase-3-ink: #ffffff;
    --tpop-phase-4-ink: #ffffff;

    --tpop-tranche-1: #d95926;
    --tpop-tranche-2: #199e70;
    --tpop-tranche-3: #9085e9;
    --tpop-tranche-1-tint: #2a1c14;
    --tpop-tranche-2-tint: #12271f;
    --tpop-tranche-3-tint: #211d38;

    --tpop-status-good: #0ca30c;
    --tpop-status-warn: #fab219;
    --tpop-status-serious: #ec835a;
    --tpop-status-good-tint: #12271a;
    --tpop-status-warn-tint: #2e2712;
    --tpop-status-serious-tint: #2e1c15;

