document.getElementById("statusSelect").addEventListener("change", e => { actionState.status = e.target.value; renderActions(); });
document.getElementById("overdueToggle").addEventListener("click", e => {
  actionState.overdueOnly = !actionState.overdueOnly;
  e.target.setAttribute("aria-pressed", String(actionState.overdueOnly));
  renderActions();
});
document.getElementById("actionsExpandAllBtn").addEventListener("click", () => { actionState.collapsedPhases.clear(); renderActions(); });
document.getElementById("actionsCollapseAllBtn").addEventListener("click", () => {
  phaseOrder.forEach(p => actionState.collapsedPhases.add(p));
  renderActions();
});
document.getElementById("actionsBody").addEventListener("click", e => {
  const header = e.target.closest(".phase-header");
  if (!header) return;
  const p = header.dataset.phase;
  if (actionState.collapsedPhases.has(p)) actionState.collapsedPhases.delete(p); else actionState.collapsedPhases.add(p);
  renderActions();
});

